{% doc %}
  @prompt
    Create a SALE badge that overlays on product images for items that have a compare-at price (i.e. are on sale). The badge should only appear when the product has a compare-at price higher than the current price. Style it as a bold, eye-catching label positioned in the top-left or top-right corner of the product image, using a bright accent color with dark text to match a premium anime-streetwear aesthetic.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% liquid
  assign sale_price = product.price
  assign compare_price = product.compare_at_price
  if product.selected_or_first_available_variant
    assign sale_price = product.selected_or_first_available_variant.price
    assign compare_price = product.selected_or_first_available_variant.compare_at_price
  endif
%}
{% style %}
  .ai-sale-badge-block-{{ ai_gen_id }} { position: relative; display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; }
  .ai-sale-badge-block-{{ ai_gen_id }}__image-area { position: relative; width: 100%; }
  .ai-sale-badge-block-{{ ai_gen_id }}__image-area img, .ai-sale-badge-block-{{ ai_gen_id }}__image-placeholder { display: block; width: 100%; height: auto; }
  .ai-sale-badge-block-{{ ai_gen_id }}__image-placeholder { position: relative; aspect-ratio: 1 / 1; overflow: hidden; background: {{ block.settings.placeholder_color }}; }
  .ai-sale-badge-block-{{ ai_gen_id }}__image-placeholder svg { width: 100%; height: 100%; object-fit: cover; color: {{ block.settings.placeholder_icon_color }}; }
  .ai-sale-badge-block-{{ ai_gen_id }}__label { position: absolute; z-index: 2; top: {{ block.settings.badge_offset }}px; {% if block.settings.badge_position == 'top_right' %}right: {{ block.settings.badge_offset }}px;{% else %}left: {{ block.settings.badge_offset }}px;{% endif %} display: inline-flex; align-items: center; justify-content: center; min-height: 32px; padding: 7px 12px; background: {{ block.settings.badge_color }}; color: {{ block.settings.badge_text_color }}; border: 2px solid {{ block.settings.badge_text_color }}; border-radius: {{ block.settings.badge_radius }}px; box-shadow: 3px 3px 0 {{ block.settings.badge_text_color }}; font-family: {{ block.settings.badge_font.family }}, sans-serif; font-size: {{ block.settings.badge_size }}px; font-weight: 800; letter-spacing: 0.08em; line-height: 1; text-transform: uppercase; white-space: nowrap; }
  @media screen and (max-width: 749px) { .ai-sale-badge-block-{{ ai_gen_id }}__label { min-height: 28px; padding: 6px 9px; font-size: {{ block.settings.badge_size | times: 0.8 }}px; } }
{% endstyle %}
<div class="ai-sale-badge-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-sale-badge-block-{{ ai_gen_id }}__image-area">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 1600 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
    {% else %}
      <div class="ai-sale-badge-block-{{ ai_gen_id }}__image-placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
    {% endif %}
    {% if compare_price != blank and compare_price > sale_price %}<span class="ai-sale-badge-block-{{ ai_gen_id }}__label" aria-label="On sale">{{ block.settings.badge_text }}</span>{% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Sale badge",
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Sale" },
    { "type": "select", "id": "badge_position", "label": "Position", "options": [{ "value": "top_left", "label": "Top left" }, { "value": "top_right", "label": "Top right" }], "default": "top_left" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Badge style" },
    { "type": "color", "id": "badge_color", "label": "Background", "default": "#FFD84D" },
    { "type": "color", "id": "badge_text_color", "label": "Text and border", "default": "#000000" },
    { "type": "font_picker", "id": "badge_font", "label": "Font", "default": "sans-serif" },
    { "type": "range", "id": "badge_size", "label": "Text size", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "badge_radius", "label": "Corner radius", "min": 0, "max": 20, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "badge_offset", "label": "Edge spacing", "min": 4, "max": 32, "step": 4, "unit": "px", "default": 12 },
    { "type": "color", "id": "placeholder_color", "label": "Placeholder background", "default": "#2A2A28" },
    { "type": "color", "id": "placeholder_icon_color", "label": "Placeholder icon", "default": "#F4F3EF" }
  ],
  "presets": [{ "name": "Sale badge" }],
  "tag": null,
  "class": "sale-badge-block"
}
{% endschema %}