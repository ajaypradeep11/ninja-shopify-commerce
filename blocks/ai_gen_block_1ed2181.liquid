{% doc %}
  @prompt
    Create a SALE badge that overlays on product images for items that have a compare-at price (i.e. are on sale). The badge should only appear when the product has a compare-at price higher than the current price. Style it as a bold, eye-catching label positioned in the top-left or top-right corner of the product image, using a bright accent color with dark text to match a premium anime-streetwear aesthetic.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-sale-badge-wrap-{{ ai_gen_id }} { position: relative; width: {{ block.settings.desktop_width_percent }}%; height: 0; z-index: 5; pointer-events: none; }
  .ai-sale-badge-wrap-{{ ai_gen_id }} > .sale-badge {
    position: absolute; top: {{ block.settings.offset_top }}px;
    {% if block.settings.position == 'top_right' %}right{% else %}left{% endif %}: {{ block.settings.offset_side }}px;
    font-size: {{ block.settings.font_size }}px;
  }
  @media (max-width: 749px) {
    .ai-sale-badge-wrap-{{ ai_gen_id }} { width: 100%; }
    .ai-sale-badge-wrap-{{ ai_gen_id }} > .sale-badge { top: {{ block.settings.mobile_offset_top }}px; font-size: {{ block.settings.mobile_font_size }}px; }
  }
{% endstyle %}
{% assign badge_variant = product.selected_or_first_available_variant %}
{% if badge_variant.available and badge_variant.compare_at_price > badge_variant.price %}
  <div class="ai-sale-badge-wrap-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    {% render 'sale-badge', label: block.settings.badge_text %}
  </div>
{% endif %}
{% schema %}
{
  "name": "Sale badge",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Sale"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        {
          "value": "top_left",
          "label": "Top left"
        },
        {
          "value": "top_right",
          "label": "Top right"
        }
      ],
      "default": "top_left"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile font size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "header",
      "content": "Badge position"
    },
    {
      "type": "range",
      "id": "offset_top",
      "label": "Top offset",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_offset_top",
      "label": "Mobile top offset",
      "min": 0,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "offset_side",
      "label": "Side offset",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Sale badge"
    }
  ],
  "tag": null,
  "class": "sale-badge-block"
}
{% endschema %}
