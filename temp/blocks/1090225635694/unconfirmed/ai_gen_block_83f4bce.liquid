{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
  }

  .ai-editorial-{{ ai_gen_id }}__layout {
    display: grid;
    grid-template-columns: minmax(0, {{ block.settings.image_ratio }}fr) minmax(0, {{ 100 | minus: block.settings.image_ratio }}fr);
    align-items: stretch;
    min-height: 420px;
  }

  .ai-editorial-{{ ai_gen_id }}--image-right .ai-editorial-{{ ai_gen_id }}__media { order: 2; }
  .ai-editorial-{{ ai_gen_id }}--image-right .ai-editorial-{{ ai_gen_id }}__content { order: 1; }

  .ai-editorial-{{ ai_gen_id }}__media {
    position: relative;
    min-height: 320px;
    overflow: hidden;
    background: #2A2A28;
  }

  .ai-editorial-{{ ai_gen_id }}__media img,
  .ai-editorial-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
  }

  .ai-editorial-{{ ai_gen_id }}__placeholder { position: absolute; inset: 0; }
  .ai-editorial-{{ ai_gen_id }}__placeholder svg { color: #F4F3EF; background: #2A2A28; }
  .ai-editorial-{{ ai_gen_id }}__empty-state {
    position: absolute;
    right: 16px;
    bottom: 16px;
    left: 16px;
    padding: 10px 14px;
    color: #F4F3EF;
    background: rgba(0, 0, 0, 0.82);
    font-size: 13px;
    text-align: center;
  }

  .ai-editorial-{{ ai_gen_id }}__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(28px, 5vw, 76px);
  }

  .ai-editorial-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 18px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__title {
    max-width: 15ch;
    margin: 0;
    color: inherit;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(34px, 4.4vw, {{ block.settings.heading_size }}px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }

  .ai-editorial-{{ ai_gen_id }}__rule {
    width: 48px;
    height: 3px;
    margin: 25px 0;
    background: {{ block.settings.accent_color }};
  }

  .ai-editorial-{{ ai_gen_id }}__body {
    max-width: 48ch;
    color: inherit;
    font-size: 16px;
    line-height: 1.7;
  }

  .ai-editorial-{{ ai_gen_id }}__body > *:first-child { margin-top: 0; }
  .ai-editorial-{{ ai_gen_id }}__body > *:last-child { margin-bottom: 0; }

  .ai-editorial-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    padding: 12px 0;
    border-bottom: 1px solid {{ block.settings.accent_color }};
    color: {{ block.settings.accent_color }};
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .ai-editorial-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid {{ block.settings.accent_color }};
    outline-offset: 4px;
  }

  .ai-editorial-{{ ai_gen_id }}__link svg { width: 16px; height: 16px; }

  @media screen and (max-width: 749px) {
    .ai-editorial-{{ ai_gen_id }} { width: 100%; }
    .ai-editorial-{{ ai_gen_id }}__layout { grid-template-columns: 1fr; min-height: 0; }
    .ai-editorial-{{ ai_gen_id }}--image-right .ai-editorial-{{ ai_gen_id }}__media,
    .ai-editorial-{{ ai_gen_id }}--image-right .ai-editorial-{{ ai_gen_id }}__content { order: initial; }
    .ai-editorial-{{ ai_gen_id }}__media,
    .ai-editorial-{{ ai_gen_id }}__media img,
    .ai-editorial-{{ ai_gen_id }}__placeholder svg { min-height: 0; height: auto; aspect-ratio: 4 / 3; }
    .ai-editorial-{{ ai_gen_id }}__content { padding: 32px 24px 36px; }
    .ai-editorial-{{ ai_gen_id }}__title { font-size: clamp(32px, 10vw, {{ block.settings.heading_size }}px); }
  }
{% endstyle %}

<div class="ai-editorial-{{ ai_gen_id }}{% if block.settings.image_position == 'right' %} ai-editorial-{{ ai_gen_id }}--image-right{% endif %}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-{{ ai_gen_id }}__layout">
    <div class="ai-editorial-{{ ai_gen_id }}__media">
      {% if block.settings.image != blank %}
        <img src="{{ block.settings.image | image_url: width: 1800 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% else %}
        <div class="ai-editorial-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-editorial-{{ ai_gen_id }}__empty-state">Add an editorial image to complete this layout</div>
        </div>
      {% endif %}
    </div>
    <div class="ai-editorial-{{ ai_gen_id }}__content">
      {% if block.settings.eyebrow != blank %}<p class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
      {% if block.settings.heading != blank %}<h2 class="ai-editorial-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>{% endif %}
      <span class="ai-editorial-{{ ai_gen_id }}__rule" aria-hidden="true"></span>
      {% if block.settings.body != blank %}<div class="ai-editorial-{{ ai_gen_id }}__body">{{ block.settings.body }}</div>{% endif %}
      {% if block.settings.link_label != blank and block.settings.link_url != blank %}
        <a class="ai-editorial-{{ ai_gen_id }}__link" href="{{ block.settings.link_url }}">
          {{ block.settings.link_label | escape }}
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8h10M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial layout",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The culture edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories beyond the frame" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>A considered edit of style, culture, and the details that make it yours.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore the collection" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "header", "content": "Layout and style" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "range", "id": "image_ratio", "label": "Image column share", "min": 40, "max": 70, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 40, "max": 72, "step": 4, "unit": "px", "default": 56 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F4F3EF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#FFD84D" }
  ],
  "presets": [{ "name": "Editorial layout" }],
  "tag": null,
  "class": "editorial-layout-block"
}
{% endschema %}