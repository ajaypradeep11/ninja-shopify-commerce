{% doc %}
  @prompt
    Create a SALE badge that overlays on product images for items that have a compare-at price (i.e. are on sale). The badge should only appear when the product has a compare-at price higher than the current price. Style it as a bold, eye-catching label positioned in the top-left or top-right corner of the product image, using a bright accent color with dark text to match a premium anime-streetwear aesthetic.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-sale-badge-wrap-{{ ai_gen_id }}{position:relative;display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;height:0;z-index:5;pointer-events:none}.ai-sale-badge-{{ ai_gen_id }}{position:absolute;top:{{ block.settings.offset_top }}px;{% if block.settings.position == 'top_right' %}right:{{ block.settings.offset_side }}px;{% else %}left:{{ block.settings.offset_side }}px;{% endif %}display:inline-flex;align-items:center;justify-content:center;min-width:{{ block.settings.badge_min_width }}px;padding:{{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;background:{{ block.settings.badge_color }};color:{{ block.settings.badge_text_color }};border:{{ block.settings.border_width }}px solid {{ block.settings.badge_text_color }};border-radius:{{ block.settings.border_radius }}px;font-family:{{ block.settings.badge_font.family }},sans-serif;font-size:{{ block.settings.font_size }}px;font-weight:800;line-height:1;letter-spacing:{{ block.settings.letter_spacing }}px;text-transform:uppercase;box-shadow:3px 3px 0 {{ block.settings.badge_text_color }};transform:rotate({{ block.settings.rotation }}deg);white-space:nowrap}@media screen and (max-width:749px){.ai-sale-badge-wrap-{{ ai_gen_id }}{width:100%}.ai-sale-badge-{{ ai_gen_id }}{top:{{ block.settings.mobile_offset_top }}px;font-size:{{ block.settings.mobile_font_size }}px;min-width:{{ block.settings.mobile_min_width }}px}}{% endstyle %}
{% if product != blank and product.compare_at_price_max > product.price %}<div class="ai-sale-badge-wrap-{{ ai_gen_id }}" {{ block.shopify_attributes }}><span class="ai-sale-badge-{{ ai_gen_id }}" aria-label="{{ block.settings.badge_text | escape }}">{{ block.settings.badge_text | escape }}</span></div>{% endif %}
{% schema %}{"name":"Sale badge","settings":[{"type":"text","id":"badge_text","label":"Badge text","default":"Sale"},{"type":"select","id":"position","label":"Position","options":[{"value":"top_left","label":"Top left"},{"value":"top_right","label":"Top right"}],"default":"top_left"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"header","content":"Badge style"},{"type":"color","id":"badge_color","label":"Background","default":"#FFD84D"},{"type":"color","id":"badge_text_color","label":"Text and border","default":"#000000"},{"type":"font_picker","id":"badge_font","label":"Font","default":"sans-serif"},{"type":"range","id":"font_size","label":"Font size","min":10,"max":30,"step":1,"unit":"px","default":14},{"type":"range","id":"mobile_font_size","label":"Mobile font size","min":8,"max":24,"step":1,"unit":"px","default":11},{"type":"range","id":"badge_min_width","label":"Minimum width","min":40,"max":180,"step":10,"unit":"px","default":60},{"type":"range","id":"mobile_min_width","label":"Mobile minimum width","min":30,"max":140,"step":10,"unit":"px","default":50},{"type":"range","id":"border_radius","label":"Corner radius","min":0,"max":20,"step":2,"unit":"px","default":2},{"type":"range","id":"border_width","label":"Border width","min":0,"max":4,"step":1,"unit":"px","default":2},{"type":"range","id":"letter_spacing","label":"Letter spacing","min":0,"max":4,"step":1,"unit":"px","default":1},{"type":"range","id":"rotation","label":"Rotation","min":-5,"max":5,"step":1,"unit":"deg","default":-2},{"type":"header","content":"Badge position"},{"type":"range","id":"offset_top","label":"Top offset","min":0,"max":40,"step":5,"unit":"px","default":10},{"type":"range","id":"mobile_offset_top","label":"Mobile top offset","min":0,"max":30,"step":5,"unit":"px","default":10},{"type":"range","id":"offset_side","label":"Side offset","min":0,"max":40,"step":5,"unit":"px","default":10},{"type":"range","id":"badge_padding_vertical","label":"Vertical padding","min":4,"max":16,"step":2,"unit":"px","default":8},{"type":"range","id":"badge_padding_horizontal","label":"Horizontal padding","min":6,"max":24,"step":2,"unit":"px","default":12}],"presets":[{"name":"Sale badge"}],"tag":null,"class":"sale-badge-block"}{% endschema %}