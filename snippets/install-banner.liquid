<div class="install-banner" data-install-banner hidden>
  <img
    class="install-banner__icon"
    src="{{ 'icon-192.png' | asset_url }}"
    width="44"
    height="44"
    alt=""
    loading="lazy"
  >
  <div class="install-banner__copy">
    <strong>Add {{ shop.name }} to your home screen</strong>
    <span data-install-steps></span>
  </div>
  <button class="install-banner__cta" type="button" data-install-cta hidden>Install</button>
  <button class="install-banner__close" type="button" data-install-close aria-label="Dismiss">
    {% render 'icon', name: 'close' %}
  </button>
</div>
