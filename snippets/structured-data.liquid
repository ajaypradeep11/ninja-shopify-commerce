{%- comment -%} JSON-LD structured data for search engines (Product, Breadcrumb, Organization). {%- endcomment -%}
{%- liquid
  assign shop_url = shop.url
  assign logo_url = 'icon-512.png' | asset_url | prepend: 'https:' | replace: 'https:https:', 'https:'
-%}

{%- case template.name -%}
  {%- when 'product' -%}
    {%- assign product_variant = product.selected_or_first_available_variant -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "Product",
        "name": {{ product.title | json }},
        "url": {{ product.url | prepend: shop_url | json }},
        "description": {{ product.description | strip_html | truncate: 400 | json }},
        {%- if product.featured_image != blank -%}
          "image": [
            {%- for image in product.images limit: 3 -%}
              {{ image | image_url: width: 1200 | prepend: 'https:' | replace: 'https:https:', 'https:' | json }}
              {%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ],
        {%- endif -%}
        {%- if product_variant.sku != blank -%}
          "sku": {{ product_variant.sku | json }},
        {%- endif -%}
        "brand": {
          "@type": "Brand",
          "name": {{ product.vendor | default: shop.name | json }}
        },
        {%- assign rating = product.metafields.reviews.rating.value -%}
        {%- assign rating_count = product.metafields.reviews.rating_count -%}
        {%- if rating != blank and rating_count > 0 -%}
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": {{ rating.rating | json }},
            "ratingCount": {{ rating_count | json }},
            "bestRating": {{ rating.scale_max | json }},
            "worstRating": {{ rating.scale_min | json }}
          },
        {%- endif -%}
        "offers": [
          {%- for variant in product.variants -%}
            {
              "@type": "Offer",
              "name": {{ variant.title | json }},
              "url": {{ variant.url | prepend: shop_url | json }},
              "price": {{ variant.price | divided_by: 100.0 | json }},
              "priceCurrency": {{ cart.currency.iso_code | json }},
              "itemCondition": "https://schema.org/NewCondition",
              "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %}
              {%- if variant.sku != blank -%},"sku": {{ variant.sku | json }}{%- endif -%}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": {{ shop_url | json }}
          },
          {%- if collection != blank -%}
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ collection.title | json }},
              "item": {{ collection.url | prepend: shop_url | json }}
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ product.title | json }},
              "item": {{ product.url | prepend: shop_url | json }}
            }
          {%- else -%}
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ product.title | json }},
              "item": {{ product.url | prepend: shop_url | json }}
            }
          {%- endif -%}
        ]
      }
    </script>

  {%- when 'collection' -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "CollectionPage",
        "name": {{ collection.title | json }},
        "url": {{ collection.url | prepend: shop_url | json }},
        {%- if collection.description != blank -%}
          "description": {{ collection.description | strip_html | truncate: 300 | json }},
        {%- endif -%}
        "isPartOf": {
          "@type": "WebSite",
          "name": {{ shop.name | json }},
          "url": {{ shop_url | json }}
        }
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": {{ shop_url | json }}
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ collection.url | prepend: shop_url | json }}
          }
        ]
      }
    </script>

  {%- when 'article' -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "Article",
        "headline": {{ article.title | json }},
        "url": {{ article.url | prepend: shop_url | json }},
        "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }},
        {%- if article.image != blank -%}
          "image": [{{ article.image | image_url: width: 1200 | prepend: 'https:' | replace: 'https:https:', 'https:' | json }}],
        {%- endif -%}
        "author": {
          "@type": "Organization",
          "name": {{ article.author | default: shop.name | json }}
        },
        "publisher": {
          "@type": "Organization",
          "name": {{ shop.name | json }},
          "logo": {
            "@type": "ImageObject",
            "url": {{ logo_url | json }}
          }
        }
      }
    </script>
{%- endcase -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop_url | json }},
    "logo": {{ logo_url | json }},
    "email": {{ shop.email | json }},
    "areaServed": [
      { "@type": "City", "name": "Ottawa" },
      { "@type": "Country", "name": "Canada" }
    ],
    "sameAs": [
      "https://www.instagram.com/localninja.ca",
      "https://www.tiktok.com/@localninja.ca"
    ]
  }
</script>

{%- if template.name == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop_url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": {{ shop_url | append: '/search?q={search_term_string}' | json }}
        },
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}
