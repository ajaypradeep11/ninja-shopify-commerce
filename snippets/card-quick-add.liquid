{% doc %}
  @param {product} product - Product shown on the card.
  @param {string} product_url - Product page for options that require more configuration.
{% enddoc %}
{%- assign variants = product.variants | where: 'available', true -%}
{%- if product.requires_selling_plan or variants == empty or product.variants_count > 250 -%}
  <a class="card-quick-add card-quick-add__toggle" href="{{ product_url }}" aria-label="{{ 'products.product.choose_options_for' | t: product: product.title | escape }}">
    {% render 'icon', name: 'plus' %}
  </a>
{%- else -%}
  <form class="card-quick-add" action="{{ routes.cart_add_url }}" method="post" data-product-form>
    {%- if variants.size == 1 -%}
      <input type="hidden" name="id" value="{{ variants.first.id }}" data-available="true">
      <button type="submit" class="card-quick-add__toggle" aria-label="{{ 'products.product.add_product_to_cart' | t: product: product.title | escape }}">
        {% render 'icon', name: 'plus' %}
      </button>
    {%- else -%}
      <details>
        <summary class="card-quick-add__toggle" aria-label="{{ 'products.product.choose_options_for' | t: product: product.title | escape }}">
          {% render 'icon', name: 'plus' %}
        </summary>
        <div class="card-quick-add__options">
          <label>
            {{ product.options | join: ' / ' | escape }}
            <select name="id" required>
              <option value="" selected disabled>{{ 'products.product.choose_option' | t }}</option>
              {%- for variant in variants -%}
                <option value="{{ variant.id }}" data-available="true">{{ variant.title | escape }} · {{ variant.price | money_with_currency | strip_html }}</option>
              {%- endfor -%}
            </select>
          </label>
          <button type="submit" class="button">{{ 'products.product.add_to_cart' | t }}</button>
        </div>
      </details>
    {%- endif -%}
  </form>
{%- endif -%}
