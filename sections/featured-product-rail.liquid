{%- liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank
    assign featured_collection = collections['all']
  endif
-%}

<section class="section-pad">
  <div class="container-wide section-heading section-heading--compact">
    <h2>{{ section.settings.heading }}</h2>
    <a class="text-link" href="{{ featured_collection.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
  </div>

  {%- if featured_collection.products_count > 0 -%}
    <div class="product-rail" data-product-rail>
      {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
        <div class="product-rail__item">{% render 'product-card', product: product, show_vendor: section.settings.show_vendor %}</div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="container-wide section-empty">
      <p>Add products to the selected collection to populate this rail.</p>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product rail",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "ALL PRODUCTS" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 24, "step": 4, "label": "Products to show", "default": 20 }
  ],
  "presets": [{ "name": "Product rail" }]
}
{% endschema %}

