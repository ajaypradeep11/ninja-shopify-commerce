<section class="customer-page">
  <div class="wordmark" style="justify-content:flex-start;margin-bottom:28px">
    <img class="wordmark__logo" src="{{ 'logo-animated.svg' | asset_url }}" width="64" height="64" alt="">
    <span>{{ settings.wordmark_base }}<span class="wordmark__accent">{{ settings.wordmark_accent }}</span></span>
  </div>
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.text }}</p>
  {%- form 'storefront_password', class: 'form-grid' -%}
    {%- if form.errors -%}<div class="form-errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="StorePassword">Store password</label><input id="StorePassword" type="password" name="password" autocomplete="current-password" required></div>
    <button class="button" type="submit">Enter store</button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "LocalNinja is getting ready. Enter the store password to preview." }
  ]
}
{% endschema %}
