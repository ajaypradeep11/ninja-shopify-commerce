<section class="customer-page" style="width:min(100% - 32px, 1100px)">
  <p class="eyebrow">Placed {{ order.created_at | date: '%B %d, %Y' }}</p>
  <h1>{{ order.name }}</h1>
  {%- if order.cancelled -%}<div class="form-errors">Cancelled {{ order.cancelled_at | date: '%B %d, %Y' }} — {{ order.cancel_reason_label }}</div>{%- endif -%}

  <div style="overflow-x:auto">
    <table class="account-orders">
      <thead><tr><th>Product</th><th>SKU</th><th>Price</th><th>Quantity</th><th>Total</th></tr></thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>{%- if line_item.url -%}<a class="text-link" href="{{ line_item.url }}">{{ line_item.title }}</a>{%- else -%}{{ line_item.title }}{%- endif -%}</td>
            <td>{{ line_item.sku }}</td>
            <td>{{ line_item.final_price | money }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr><th colspan="4">Subtotal</th><td>{{ order.line_items_subtotal_price | money }}</td></tr>
        {%- for shipping_method in order.shipping_methods -%}<tr><th colspan="4">Shipping ({{ shipping_method.title }})</th><td>{{ shipping_method.price | money }}</td></tr>{%- endfor -%}
        {%- for tax_line in order.tax_lines -%}<tr><th colspan="4">Tax ({{ tax_line.title }})</th><td>{{ tax_line.price | money }}</td></tr>{%- endfor -%}
        <tr><th colspan="4">Total</th><td>{{ order.total_net_amount | money_with_currency }}</td></tr>
      </tfoot>
    </table>
  </div>
  <div class="customer-actions"><a class="button button--outline" href="{{ routes.account_url }}">Back to account</a></div>
</section>

{% schema %}
{ "name": "Order detail" }
{% endschema %}

