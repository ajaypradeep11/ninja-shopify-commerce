{% for block in section.blocks %}
  {% case block.type %}
    {% when 'caption' %}
      <style>
        .hrs-caption-{{ block.id }} {
          display: flex;
          flex-wrap: wrap;
          align-items: center;
          justify-content: center;
          gap: 6px 14px;
          margin-bottom: {{ block.settings.caption_mb_mobile }}px;
          text-align: center;
        }

        .hrs-caption-main-{{ block.id }},
        .hrs-caption-secondary-{{ block.id }} {
          margin: 0;
          font-size: {{ block.settings.caption_size_mobile }}px;
          font-weight: 400;
          line-height: {{ block.settings.caption_height }}%;
          color: {{ block.settings.caption_color }};
          text-transform: unset;
          word-break: break-word;
        }

        .hrs-caption-secondary-{{ block.id }} {
          color: {{ block.settings.caption_secondary_color }};
        }

        .hrs-caption-divider-{{ block.id }} {
          display: block !important;
          width: 1px;
          height: {{ block.settings.caption_size_mobile }}px;
          background-color: {{ block.settings.caption_divider_color }};
        }

        @media(min-width: 1024px) {
          .hrs-caption-{{ block.id }} {
            margin-bottom: {{ block.settings.caption_mb }}px;
          }

          .hrs-caption-main-{{ block.id }},
          .hrs-caption-secondary-{{ block.id }} {
            font-size: {{ block.settings.caption_size }}px;
          }

          .hrs-caption-divider-{{ block.id }} {
            height: {{ block.settings.caption_size }}px;
          }
        }
      </style>

      {% if block.settings.caption_custom %}
        <style>
          {{ block.settings.caption_font | font_face: font_display: 'swap' }}

          .hrs-caption-main-{{ block.id }},
          .hrs-caption-secondary-{{ block.id }} {
            font-family: {{ block.settings.caption_font.family }}, {{ block.settings.caption_font.fallback_families }};
            font-weight: {{ block.settings.caption_font.weight }};
            font-style: {{ block.settings.caption_font.style }};
          }
        </style>
      {% endif %}
    {% when 'title' %}
      <style>
        .hrs-title-{{ block.id }} {
          display: block !important;
          min-height: calc({{ block.settings.title_size_mobile }}px * {{ block.settings.title_height }} / 100);
          margin: 0;
          margin-top: {{ block.settings.title_mt_mobile }}px !important;
          font-size: {{ block.settings.title_size_mobile }}px;
          font-weight: 700;
          line-height: {{ block.settings.title_height }}%;
          color: {{ block.settings.title_color }};
          text-align: center;
          text-transform: unset;
          word-break: break-word;
          transition: opacity 0.18s ease;
        }

        .hrs-title-{{ block.id }}.hrs-is-swapping {
          opacity: 0;
        }

        @media(min-width: 1024px) {
          .hrs-title-{{ block.id }} {
            min-height: calc({{ block.settings.title_size }}px * {{ block.settings.title_height }} / 100);
            margin-top: {{ block.settings.title_mt }}px !important;
            font-size: {{ block.settings.title_size }}px;
          }
        }
      </style>

      {% if block.settings.title_custom %}
        <style>
          {{ block.settings.title_font | font_face: font_display: 'swap' }}

          .hrs-title-{{ block.id }} {
            font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
            font-weight: {{ block.settings.title_font.weight }};
            font-style: {{ block.settings.title_font.style }};
          }
        </style>
      {% endif %}
    {% when 'button' %}
      <style>
        .hrs-button-{{ block.id }} {
          position: relative;
          text-decoration: none;
          margin-top: {{ block.settings.button_mt_mobile }}px !important;
          width: {% if block.settings.button_full_width_mobile %}100%{% else %}fit-content{% endif %};
        }

        .hrs-button-inner-{{ block.id }} {
          display: flex;
          align-items: center;
          justify-content: center;
          max-width: {% if block.settings.button_full_width_mobile %}100%{% else %}fit-content{% endif %};
          gap: 10px;
          width: 100%;
          margin: 0;
          font-size: {{ block.settings.button_size_mobile }}px;
          font-weight: 700;
          color: {{ block.settings.button_color }};
          line-height: {{ block.settings.button_height }}%;
          text-align: center;
          text-transform: unset;
          text-decoration: none;
          padding: {{ block.settings.button_padding_vertical_mobile }}px {{ block.settings.button_padding_horizontal_mobile }}px;
          border-radius: {{ block.settings.button_radius }}px;
          transition: all 0.25s ease 0s;
          background-color: transparent;
          border: 0px;
          cursor: pointer;
          {% if block.settings.button_custom_styling and block.settings.button_style != "link" %}
            position: relative;
            overflow: hidden;
          {% endif %}
        }

        {% if block.settings.button_custom_styling and block.settings.button_style != "link" %}
          .hrs-button-inner-{{ block.id }} {
            background: linear-gradient(180deg, {{ block.settings.button_bg_color | color_lighten: 4 }}, {{ block.settings.button_bg_color | color_darken: 10 }});
            box-shadow: 0 14px 30px {{ block.settings.button_shadow_color | color_modify: 'alpha', 0.28 }}, 0 5px 12px {{ block.settings.button_shadow_color | color_modify: 'alpha', 0.2 }}, inset 0 1px 0 #ffffff26;
            backdrop-filter: saturate(1.05);
          }

          .hrs-button-inner-{{ block.id }}::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            transition: left 0.6s ease;
          }

          .hrs-button-inner-{{ block.id }}:hover::before {
            left: 100%;
          }

          .hrs-button-inner-{{ block.id }}:hover {
            color: {{ block.settings.button_hover_color }};
            background: linear-gradient(180deg, {{ block.settings.button_bg_hover_color | color_lighten: 4 }}, {{ block.settings.button_bg_hover_color | color_darken: 10 }});
            transform: translateY(-2px);
            box-shadow: 0 18px 36px {{ block.settings.button_shadow_color | color_modify: 'alpha', 0.34 }}, 0 7px 16px {{ block.settings.button_shadow_color | color_modify: 'alpha', 0.24 }}, inset 0 1px 0 #ffffff33;
          }

          .hrs-button-inner-{{ block.id }}:active {
            transform: translateY(1px);
            filter: brightness(1.00208);
            box-shadow: 0 4px 8px {{ block.settings.button_shadow_color | color_modify: 'alpha', 0.3 }}, 0 2px 4px {{ block.settings.button_shadow_color | color_modify: 'alpha', 0.2 }}, inset 0 1px 0 #ffffff0d, inset 0 -1px 0 {{ block.settings.button_shadow_color | color_modify: 'alpha', 0.2 }};
          }
        {% else %}
          .hrs-button-inner-{{ block.id }}:hover {
            color: {{ block.settings.button_hover_color }};
          }
        {% endif %}

        .hrs-button-inner-{{ block.id }} svg {
          width: 14px !important;
          height: 14px !important;
          background: transparent;
          min-height: auto !important;
          flex: none;
        }

        @media(min-width: 1024px) {
          .hrs-button-{{ block.id }} {
            margin-top: {{ block.settings.button_mt }}px !important;
            width: fit-content;
          }

          .hrs-button-inner-{{ block.id }} {
            display: flex !important;
            max-width: fit-content;
            padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
            font-size: {{ block.settings.button_size }}px;
          }
        }
      </style>

      {% if block.settings.button_custom %}
        <style>
          {{ block.settings.button_font | font_face: font_display: 'swap' }}

          .hrs-button-inner-{{ block.id }} {
            font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
            font-weight: {{ block.settings.button_font.weight }};
            font-style: {{ block.settings.button_font.style }};
          }
        </style>
      {% endif %}

      {% if block.settings.button_style == "non_outline" or block.settings.button_style == "non_outline_arrow" %}
        <style>
          .hrs-button-inner-{{ block.id }} {
            background-color: {{ block.settings.button_bg_color }};
          }

          .hrs-button-inner-{{ block.id }}:hover {
            background-color: {{ block.settings.button_bg_hover_color }};
          }
        </style>
      {% elsif block.settings.button_style == "outline" or block.settings.button_style == "outline_arrow" %}
        <style>
          .hrs-button-inner-{{ block.id }} {
            background-color: {{ block.settings.button_bg_color }};
            border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
          }

          .hrs-button-inner-{{ block.id }}:hover {
            background-color: {{ block.settings.button_bg_hover_color }};
            border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_hover_color }};
          }
        </style>
      {% elsif block.settings.button_style == "link" %}
        <style>
          .hrs-button-inner-{{ block.id }} {
            padding: 0px !important;
          }
        </style>
      {% endif %}
  {% endcase %}
{% endfor %}

<div
  class="section-{{ section.id }} hrs-section-{{ section.id }}{% if drop_in %} hrs-pre-{{ section.id }}{% endif %}"
  {% if background_style == 'solid' %}
    style="background-color:{{ background_color }};"
  {% else %}
    style="background-image: {{ background_gradient }};"
  {% endif %}
>
  <div class="section-{{ section.id }}-settings">
    {%- for block in section.blocks -%}
      {%- if block.type == 'caption' -%}
        {%- if block.settings.caption != blank or block.settings.caption_secondary != blank -%}
          <div class="hrs-caption-{{ block.id }}" {{ block.shopify_attributes }}>
            {%- if block.settings.caption != blank -%}
              <p class="hrs-caption-main-{{ block.id }}">{{ block.settings.caption }}</p>
            {%- endif -%}
            {%- if block.settings.caption != blank and block.settings.caption_secondary != blank -%}
              <span class="hrs-caption-divider-{{ block.id }}" aria-hidden="true"></span>
            {%- endif -%}
            {%- if block.settings.caption_secondary != blank -%}
              <p class="hrs-caption-secondary-{{ block.id }}">{{ block.settings.caption_secondary }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    <div class="hrs-stage-{{ section.id }}">
      {%- if show_rod -%}
        <div class="hrs-rod-{{ section.id }}" aria-hidden="true">
          {%- case rail_style -%}
            {%- when 'brackets' -%}
              <span class="hrs-rod-end-{{ section.id }}"></span>
              <span class="hrs-rod-end-{{ section.id }}"></span>
            {%- when 'curved' -%}
              <svg
                class="hrs-rod-curve-{{ section.id }}"
                data-hrs-curve
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                focusable="false"
              >
                <defs>
                  <filter id="hrs-soft-{{ section.id }}">
                    <feGaussianBlur stdDeviation="0.6"/>
                  </filter>
                </defs>
                <path stroke="{{ rail_edge }}" stroke-width="8" data-hrs-offset="0"/>
                <path stroke="{{ rail_shade }}" stroke-width="7.4" data-hrs-offset="-0.3"/>
                <g filter="url(#hrs-soft-{{ section.id }})">
                  <path stroke="{{ rail_base }}" stroke-width="5.6" data-hrs-offset="-0.4"/>
                  <path stroke="{{ rail_light }}" stroke-width="3.6" data-hrs-offset="-1.2"/>
                  <path stroke="{{ rail_hi }}" stroke-width="1.2" data-hrs-offset="-1.5"/>
                </g>
              </svg>
          {%- endcase -%}
        </div>
      {%- endif -%}

      <div class="hrs-rack-{{ section.id }}" data-hrs-rack>
        {%- assign item_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'product' -%}
            {%- liquid
              assign item_index = item_index | plus: 1
              assign placeholder_index = item_index | minus: 1 | modulo: 4 | plus: 1
              assign placeholder_name = 'product-apparel-' | append: placeholder_index

              assign item_product = block.settings.product
              assign side = block.settings.image_side
              assign front = block.settings.image_front
              assign back = block.settings.image_back

              if front == blank and item_product != blank
                assign front = item_product.featured_media.preview_image
              endif

              assign has_side = false
              if side != blank
                assign has_side = true
              endif

              assign has_front = false
              if front != blank
                assign has_front = true
              endif

              if has_side and has_front
                assign can_turn = true
                assign side_ratio = side.aspect_ratio
                assign front_ratio = front.aspect_ratio
              elsif has_side
                assign can_turn = false
                assign side_ratio = side.aspect_ratio
                assign front_ratio = side.aspect_ratio
              elsif has_front
                assign can_turn = false
                assign side_ratio = front.aspect_ratio
                assign front_ratio = front.aspect_ratio
              else
                assign can_turn = true
                assign side_ratio = 0.34
                assign front_ratio = 0.75
              endif

              assign side_px = garment_height | times: side_ratio | ceil
              assign side_px_mobile = garment_height_mobile | times: side_ratio | ceil
              assign front_px = garment_height | times: front_ratio | ceil
              assign front_px_mobile = garment_height_mobile | times: front_ratio | ceil

              assign tag_on_sale = false
              if item_product != blank
                assign item_name = item_product.title
                assign item_url = item_product.url
                assign first_variant = item_product.selected_or_first_available_variant
                assign item_price = first_variant.price | money | strip_html
                assign item_compare = ''
                if first_variant.compare_at_price > first_variant.price
                  assign item_compare = first_variant.compare_at_price | money | strip_html
                endif
                assign tag_price = item_product.price | money_without_trailing_zeros
                assign lowest_price_variants = item_product.variants | where: 'price', item_product.price
                for tag_variant in lowest_price_variants
                  if tag_variant.compare_at_price > tag_variant.price
                    assign tag_on_sale = true
                    break
                  endif
                endfor
              else
                assign item_name = 'Product name'
                assign item_url = ''
                assign item_price = 4900 | money | strip_html
                assign item_compare = ''
                assign tag_price = 4900 | money_without_trailing_zeros
              endif

              assign tag_status = ''
              if item_product != blank and show_tag_status
                if item_product.available == false
                  assign tag_status = soldout_label
                elsif tag_on_sale
                  assign tag_status = tag_sale_label
                endif
              endif

              assign item_tag = 'div'
              if show_popup == false and item_product != blank
                assign item_tag = 'a'
              endif

              assign item_hooked = hanger_hooks
              if has_side == false and has_front == false
                assign item_hooked = true
              endif

              assign side_alt = side.alt | default: item_name
              assign front_alt = front.alt | default: item_name
              assign back_alt = back.alt | default: item_name

              assign popup_image = front
              if has_front == false
                assign popup_image = side
              endif
              assign popup_alt = popup_image.alt | default: item_name
            -%}

            {%- capture sizes_side -%}(min-width: 1024px) {{ side_px }}px, {{ side_px_mobile }}px{%- endcapture -%}
            {%- capture sizes_front -%}(min-width: 1024px) {{ front_px }}px, {{ front_px_mobile }}px{%- endcapture -%}
            {%- capture popup_srcset -%}
              {%- if show_popup and popup_image != blank -%}{{ popup_image | image_url: width: 600 }} 600w, {{ popup_image | image_url: width: 900 }} 900w, {{ popup_image | image_url: width: 1200 }} 1200w, {{ popup_image | image_url: width: 1600 }} 1600w{%- endif -%}
            {%- endcapture -%}
            {%- capture back_srcset -%}
              {%- if show_popup and back != blank -%}{{ back | image_url: width: 600 }} 600w, {{ back | image_url: width: 900 }} 900w, {{ back | image_url: width: 1200 }} 1200w, {{ back | image_url: width: 1600 }} 1600w{%- endif -%}
            {%- endcapture -%}

            <{{ item_tag }}
              class="hrs-item-{{ section.id }}{% if can_turn %} hrs-can-turn{% endif %}{% if item_hooked %} hrs-is-hooked{% endif %}"
              data-hrs-item
              data-block-id="{{ block.id }}"
              data-side="{{ side_ratio }}"
              data-front="{{ front_ratio }}"
              style="--hrs-side: {{ side_ratio }}; --hrs-front: {{ front_ratio }};"
              {% if item_tag == 'a' %}
                href="{{ item_url }}"
                aria-label="{{ item_name | escape }}"
              {% elsif show_popup %}
                role="button"
                tabindex="0"
                aria-label="{{ item_name | escape }}"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="hrs-swing-{{ section.id }}" data-hrs-swing>
                {%- if item_hooked -%}
                  <svg
                    class="hrs-hook-{{ section.id }}"
                    viewBox="0 0 20 40"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M5.6 7.6C5.6 4.2 7.6 1.6 10.2 1.6C12.7 1.6 14.6 3.6 14.6 6.1C14.6 9.7 10 11.1 10 15.1V40" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- endif -%}

                <div class="hrs-garment-{{ section.id }}" data-hrs-garment>
                  <div class="hrs-view-{{ section.id }} hrs-view-side-{{ section.id }}" data-hrs-view="side">
                    {%- if has_side -%}
                      {{ side | image_url: width: 900 | image_tag: class: img_class, loading: loading_attribute, widths: '150, 300, 450, 600, 900', sizes: sizes_side, alt: side_alt }}
                    {%- elsif has_front -%}
                      {{ front | image_url: width: 1200 | image_tag: class: img_class, loading: loading_attribute, widths: '300, 450, 600, 900, 1200', sizes: sizes_front, alt: front_alt }}
                    {%- else -%}
                      {{ placeholder_name | placeholder_svg_tag: placeholder_class }}
                    {%- endif -%}
                  </div>

                  {%- if can_turn -%}
                    <div class="hrs-view-{{ section.id }} hrs-view-front-{{ section.id }}" data-hrs-view="front">
                      {%- if has_front -%}
                        {{ front | image_url: width: 1200 | image_tag: class: img_class, loading: loading_attribute, widths: '300, 450, 600, 900, 1200', sizes: sizes_front, alt: front_alt }}
                      {%- else -%}
                        {{ placeholder_name | placeholder_svg_tag: placeholder_class }}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>

                {%- if show_tags -%}
                  <div class="hrs-tag-{{ section.id }}" aria-hidden="true">
                    <span class="hrs-tag-string-{{ section.id }}"></span>
                    <div class="hrs-tag-card-{{ section.id }}{% if tag_status != blank %} hrs-tag-flip-{{ section.id }}{% endif %}">
                      <span class="hrs-tag-face-{{ section.id }}"><span class="price{% if tag_on_sale %} price--sale{% endif %}">{{ tag_price }}</span></span>
                      {%- if tag_status != blank -%}
                        <span class="hrs-tag-face-{{ section.id }} hrs-tag-back-{{ section.id }}">{{ tag_status }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              </div>

              <script type="application/json" data-hrs-json>
                {
                  "name": {{ item_name | json }},
                  "url": {{ item_url | json }},
                  "price": {{ item_price | json }},
                  "compare": {{ item_compare | json }},
                  "front": {% if show_popup and popup_image != blank %}{
                    "src": {{ popup_image | image_url: width: 1200 | json }},
                    "srcset": {{ popup_srcset | json }},
                    "ratio": {{ popup_image.aspect_ratio }},
                    "alt": {{ popup_alt | json }}
                  }{% else %}null{% endif %},
                  "back": {% if show_popup and back != blank %}{
                    "src": {{ back | image_url: width: 1200 | json }},
                    "srcset": {{ back_srcset | json }},
                    "ratio": {{ back.aspect_ratio }},
                    "alt": {{ back_alt | json }}
                  }{% else %}null{% endif %},
                  "options": [
                    {%- if show_popup and show_quickadd and item_product != blank and item_product.has_only_default_variant == false -%}
                      {%- for option in item_product.options_with_values -%}
                        {"name": {{ option.name | json }}, "values": [
                          {%- for value in option.values -%}
                            {%- capture value_name -%}{{ value }}{%- endcapture -%}
                            {{ value_name | json }}{%- unless forloop.last -%},{%- endunless -%}
                          {%- endfor -%}
                        ]}{%- unless forloop.last -%},{%- endunless -%}
                      {%- endfor -%}
                    {%- endif -%}
                  ],
                  "variants": [
                    {%- if show_popup and show_quickadd and item_product != blank -%}
                      {%- for variant in item_product.variants limit: 250 -%}
                        {"id": {{ variant.id }}, "available": {{ variant.available | json }}, "price": {{ variant.price | money | strip_html | json }}, "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | strip_html | json }}{% else %}""{% endif %}, "options": {{ variant.options | json }}}{%- unless forloop.last -%},{%- endunless -%}
                      {%- endfor -%}
                    {%- endif -%}
                  ]
                }
              </script>
            </{{ item_tag }}>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if show_dots and product_count > 1 -%}
      <div class="hrs-dots-{{ section.id }}" data-hrs-dots>
        {%- for dot_index in (1..product_count) -%}
          <button
            type="button"
            class="hrs-dot-{{ section.id }}{% if forloop.first %} hrs-is-on{% endif %}"
            data-hrs-dot
            aria-label="{{ dot_index }} / {{ product_count }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="hrs-footer-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            {%- if block.settings.title != blank or block.settings.show_name -%}
              <p
                class="hrs-title-{{ block.id }}"
                data-hrs-title
                data-swap="{{ block.settings.show_name }}"
                {{ block.shopify_attributes }}
              >{{ block.settings.title | escape }}</p>
            {%- endif -%}
          {%- when 'button' -%}
            {% if block.settings.button != blank %}
              <{% if block.settings.url != blank %}a href="{{ block.settings.url }}"{% if block.settings.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}{% else %}div{% endif %} class="hrs-button-{{ block.id }}" {{ block.shopify_attributes }}>
                <p class="hrs-button-inner-{{ block.id }}">
                  {{ block.settings.button }}
                  {% if block.settings.button_style == "non_outline_arrow" or block.settings.button_style == "outline_arrow" %}
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 18 18"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path d="M3.75 9H14.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M9 3.75L14.25 9L9 14.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {% endif %}
                </p>
              </{% if block.settings.url != blank %}a{% else %}div{% endif %}>
            {% endif %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if show_popup -%}
    <div
      class="hrs-popup-{{ section.id }}"
      data-hrs-popup
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
    >
      <div class="hrs-popup-bg-{{ section.id }}" data-hrs-popup-bg></div>

      <button type="button" class="hrs-popup-close-{{ section.id }}" data-hrs-popup-close aria-label="Close">
        <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
          <path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>

      <div class="hrs-popup-inner-{{ section.id }}" data-hrs-popup-inner>
        <div class="hrs-popup-stage-{{ section.id }}" data-hrs-popup-stage>
          <div class="hrs-popup-card-{{ section.id }}" data-hrs-popup-card>
            <div class="hrs-popup-face-{{ section.id }}" data-hrs-popup-front></div>
            <div class="hrs-popup-face-{{ section.id }} hrs-popup-back-{{ section.id }}" data-hrs-popup-back></div>
          </div>
        </div>

        <div class="hrs-popup-meta-{{ section.id }}">
          <p class="hrs-popup-index-{{ section.id }}" data-hrs-popup-index></p>
          <h2 class="hrs-popup-title-{{ section.id }}" data-hrs-popup-title></h2>
          <p class="hrs-popup-price-{{ section.id }}">
            <span class="price" data-hrs-popup-price></span>
            <s class="price--compare" data-hrs-popup-compare></s>
          </p>

          <div class="hrs-popup-tabs-{{ section.id }}" data-hrs-popup-tabs>
            <button type="button" class="hrs-popup-tab-{{ section.id }} hrs-is-on" data-hrs-face="front" aria-pressed="true">{{ front_label }}</button>
            <button type="button" class="hrs-popup-tab-{{ section.id }}" data-hrs-face="back" aria-pressed="false">{{ back_label }}</button>
          </div>

          {%- if show_quickadd -%}
            <div data-hrs-popup-buy>
              <div class="hrs-popup-options-{{ section.id }}" data-hrs-popup-options></div>
              <button type="button" class="hrs-popup-atc-{{ section.id }}" data-hrs-popup-atc data-cart-app="{{ cart_app }}">
                <span class="hrs-popup-spinner-{{ section.id }}" aria-hidden="true"></span>
                <span data-hrs-popup-atc-label>{{ atc_label }}</span>
                {%- if atc_button_style == 'non_outline_arrow' or atc_button_style == 'outline_arrow' -%}
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 18 18"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M3.75 9H14.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M9 3.75L14.25 9L9 14.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- endif -%}
              </button>
              <p class="hrs-popup-error-{{ section.id }}" data-hrs-popup-error role="status" aria-live="polite"></p>
            </div>
          {%- endif -%}

          {%- if link_label != blank -%}
            <a class="hrs-popup-link-{{ section.id }}" data-hrs-popup-link href="#">{{ link_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  function initHrs_{{ section.id | replace: '-', '_' }}() {
    var section = document.querySelector('.hrs-section-{{ section.id }}');
    if (!section || section._hrs) return;

    var preClass = 'hrs-pre-{{ section.id }}';
    var rack = section.querySelector('[data-hrs-rack]');
    var items = rack ? Array.prototype.slice.call(rack.querySelectorAll('[data-hrs-item]')) : [];
    if (!items.length) {
      section.classList.remove(preClass);
      return;
    }

    var settings = {
      swing: {{ swing_strength | divided_by: 100.0 }},
      dropIn: {{ drop_in | json }},
      popup: {{ show_popup | json }},
      lift: {{ lift_animation | json }},
      autoplay: {{ autoplay | json }},
      autoplayMs: {{ autoplay_speed | times: 1000 }},
      turnMs: {{ turn_speed }},
      addLabel: {{ atc_label | json }},
      soldOutLabel: {{ soldout_label | json }},
      errorLabel: {{ atc_error_label | json }}
    };

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var fineHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    var desktopMq = window.matchMedia('(min-width: 1024px)');
    var canAnimate = typeof Element !== 'undefined' && !!Element.prototype.animate;
    var isRtl = window.getComputedStyle(rack).direction === 'rtl';
    var seen = window.hrsSeen = window.hrsSeen || {};
    var firstRun = !seen['{{ section.id }}'];
    seen['{{ section.id }}'] = true;

    var dead = false;
    var cleanups = [];
    var timers = [];

    function on(target, type, handler, options) {
      target.addEventListener(type, handler, options || false);
      cleanups.push(function () {
        target.removeEventListener(type, handler, options || false);
      });
    }

    function later(fn, ms) {
      var id = setTimeout(function () {
        timers.splice(timers.indexOf(id), 1);
        if (!dead) fn();
      }, ms);
      timers.push(id);
      return id;
    }

    function clamp(value, min, max) {
      return Math.min(max, Math.max(min, value));
    }

    function inView(rect) {
      return rect.width > 0 && rect.bottom > 0 && rect.top < window.innerHeight && rect.right > 0 && rect.left < window.innerWidth;
    }

    var states = items.map(function (el, index) {
      var data = {};
      var json = el.querySelector('[data-hrs-json]');
      if (json) {
        try {
          data = JSON.parse(json.textContent);
        } catch (error) {
          data = {};
        }
      }
      return {
        el: el,
        index: index,
        blockId: el.getAttribute('data-block-id'),
        swing: el.querySelector('[data-hrs-swing]'),
        garment: el.querySelector('[data-hrs-garment]'),
        side: parseFloat(el.getAttribute('data-side')) || 0.34,
        front: parseFloat(el.getAttribute('data-front')) || 0.75,
        sideView: el.querySelector('[data-hrs-view="side"]'),
        frontView: el.querySelector('[data-hrs-view="front"]'),
        canTurn: !!el.querySelector('[data-hrs-view="front"]'),
        data: data,
        progress: 0,
        target: 0,
        angle: 0,
        velocity: 0
      };
    });

    var titleEl = section.querySelector('[data-hrs-title]');
    var titleSwap = !!titleEl && titleEl.getAttribute('data-swap') === 'true';
    var titleDefault = titleEl ? titleEl.innerHTML : '';
    var titleKey = -1;
    var titleTimer = null;

    function setTitle(state) {
      if (!titleSwap) return;
      var key = state ? state.index : -1;
      if (key === titleKey) return;
      titleKey = key;
      titleEl.classList.add('hrs-is-swapping');
      clearTimeout(titleTimer);
      titleTimer = setTimeout(function () {
        if (state) titleEl.textContent = state.data.name || '';
        else titleEl.innerHTML = titleDefault;
        titleEl.classList.remove('hrs-is-swapping');
      }, 180);
    }

    var swingOn = settings.swing > 0 && !reduceMotion;
    var swingFrame = 0;
    var swingLast = 0;

    function push(state, velocity) {
      if (!swingOn || !state || dead) return;
      state.velocity += velocity * settings.swing;
      if (!swingFrame) {
        swingLast = 0;
        swingFrame = requestAnimationFrame(swingStep);
      }
    }

    function swingStep(time) {
      swingFrame = 0;
      if (dead) return;
      var dt = swingLast ? Math.min(0.05, (time - swingLast) / 1000) : 1 / 60;
      swingLast = time;
      var moving = false;
      states.forEach(function (state) {
        if (Math.abs(state.angle) < 0.03 && Math.abs(state.velocity) < 0.08) {
          if (state.angle || state.velocity) {
            state.angle = 0;
            state.velocity = 0;
            state.swing.style.removeProperty('--hrs-sw');
          }
          return;
        }
        var step = dt / 2;
        for (var i = 0; i < 2; i++) {
          state.velocity += (-26 * state.angle - 2.3 * state.velocity) * step;
          state.angle += state.velocity * step;
        }
        if (Math.abs(state.angle) > 11) {
          state.angle = state.angle > 0 ? 11 : -11;
          state.velocity *= -0.35;
        }
        state.swing.style.setProperty('--hrs-sw', state.angle.toFixed(2) + 'deg');
        moving = true;
      });
      if (moving) swingFrame = requestAnimationFrame(swingStep);
      else swingLast = 0;
    }

    function nudgeNeighbours(state, strength, skip) {
      var direction = isRtl ? -1 : 1;
      if (states[state.index - 1] !== skip) push(states[state.index - 1], strength * direction);
      if (states[state.index + 1] !== skip) push(states[state.index + 1], -strength * direction);
    }

    var sectionVisible = !('IntersectionObserver' in window);
    var lastScrollY = window.pageYOffset;
    var lastScrollTime = 0;

    on(window, 'scroll', function () {
      if (!swingOn || !sectionVisible) return;
      var now = performance.now();
      if (now - lastScrollTime < 100) return;
      var y = window.pageYOffset;
      var elapsed = now - lastScrollTime;
      var delta = y - lastScrollY;
      lastScrollY = y;
      lastScrollTime = now;
      if (elapsed > 400 || !delta) return;
      var gust = clamp(delta / elapsed * 8, -14, 14);
      states.forEach(function (state) {
        push(state, gust * (state.index % 2 ? 1 : -0.85));
      });
    }, { passive: true });

    var lastRackX = 0;
    var lastRackTime = 0;

    on(rack, 'scroll', function () {
      if (!swingOn || desktopMq.matches) return;
      var now = performance.now();
      if (now - lastRackTime < 70) return;
      var x = rack.scrollLeft;
      var elapsed = now - lastRackTime;
      var delta = x - lastRackX;
      lastRackX = x;
      lastRackTime = now;
      if (elapsed > 300 || !delta || Math.abs(delta) > 600) return;
      var drag = clamp(delta / elapsed * 12, -24, 24);
      states.forEach(function (state) {
        push(state, -drag);
      });
    }, { passive: true });

    var turned = null;
    var popupState = null;
    var prefetched = {};

    function popupSizes(ratio) {
      var height = desktopMq.matches ? Math.min(window.innerHeight * 0.76, 680) : Math.min(window.innerHeight * 0.46, 440);
      return Math.ceil(height * (ratio || 0.75)) + 'px';
    }

    function makeImage(image) {
      var img = document.createElement('img');
      img.alt = image.alt || '';
      img.decoding = 'async';
      img.draggable = false;
      img.sizes = popupSizes(image.ratio);
      img.srcset = image.srcset;
      img.src = image.src;
      return img;
    }

    function prefetch(state) {
      if (!settings.popup) return;
      [state.data.front, state.data.back].forEach(function (image) {
        if (!image || prefetched[image.src]) return;
        prefetched[image.src] = true;
        makeImage(image);
      });
    }

    var turnFrame = 0;
    var turnLast = 0;

    function turnStep(time) {
      turnFrame = 0;
      if (dead) return;
      var dt = turnLast ? Math.min(64, time - turnLast) : 0;
      turnLast = time;
      var ease = 1 - Math.exp(-dt / (settings.turnMs * 0.3));
      var busy = false;
      states.forEach(function (state) {
        if (state.progress === state.target) return;
        var delta = state.target - state.progress;
        state.progress = Math.abs(delta) > 0.02 && !reduceMotion ? state.progress + delta * ease : state.target;
        busy = true;
        var eased = state.progress * state.progress * (3 - 2 * state.progress);
        state.el.classList.toggle('hrs-is-live', eased > 0.02);
        if (!state.frontView) return;
        state.sideView.style.opacity = clamp((0.56 - eased) / 0.12, 0, 1);
        state.frontView.style.opacity = clamp((eased - 0.44) / 0.12, 0, 1);
        state.sideView.style.transform = eased > 0 ? 'perspective(900px) rotateY(' + (Math.min(1, eased * 2) * -84).toFixed(2) + 'deg)' : 'none';
        state.frontView.style.transform = eased < 1 ? 'scale(' + (0.92 + 0.08 * eased).toFixed(4) + ')' : 'none';
        if (state.progress === state.target) {
          state.sideView.style.removeProperty('will-change');
          state.frontView.style.removeProperty('will-change');
        }
      });
      if (busy) turnFrame = requestAnimationFrame(turnStep);
      else turnLast = 0;
    }

    function setTurnTarget(state, target) {
      state.target = target;
      if (state.frontView) {
        state.sideView.style.willChange = 'opacity, transform';
        state.frontView.style.willChange = 'opacity, transform';
      }
      if (!turnFrame) turnFrame = requestAnimationFrame(turnStep);
    }

    function turn(state) {
      if (turned === state) return;
      var previous = turned;
      if (previous) {
        previous.el.classList.remove('hrs-is-turned');
        setTurnTarget(previous, 0);
      }
      turned = state;
      if (state) {
        state.el.classList.add('hrs-is-turned');
        setTurnTarget(state, 1);
        later(function () {
          if (turned === state) prefetch(state);
        }, 120);
        nudgeNeighbours(state, 26);
      }
      if (previous) nudgeNeighbours(previous, -12, state);
      bendFor(settings.turnMs + 80);
      setTitle(state);
    }

    if (fineHover) {
      var mouseX = null;
      var mouseTime = 0;

      on(rack, 'mousemove', function (event) {
        if (popupState) return;
        var x = event.clientX;
        var y = event.clientY;
        var now = performance.now();

        if (swingOn && mouseX !== null && now - mouseTime < 100) {
          var speed = (x - mouseX) / Math.max(1, now - mouseTime);
          states.forEach(function (state) {
            if (state === turned) return;
            var rect = state.garment.getBoundingClientRect();
            if (y < rect.top || y > rect.bottom) return;
            var center = rect.left + rect.width / 2;
            if ((mouseX - center) * (x - center) < 0) push(state, clamp(-speed * 24, -50, 50));
          });
        }
        mouseX = x;
        mouseTime = now;

        if (turned) {
          var current = turned.el.getBoundingClientRect();
          if (x >= current.left - 20 && x <= current.right + 20 && y >= current.top - 10 && y <= current.bottom + 40) return;
        }

        var best = null;
        var bestDistance = Infinity;
        states.forEach(function (state) {
          var rect = state.el.getBoundingClientRect();
          if (y < rect.top - 10 || y > rect.bottom + 40 || x < rect.left - 2 || x > rect.right + 2) return;
          var distance = Math.abs(x - (rect.left + rect.width / 2));
          if (distance < bestDistance) {
            bestDistance = distance;
            best = state;
          }
        });
        turn(best);
      });

      on(rack, 'mouseleave', function () {
        mouseX = null;
        if (!popupState) turn(null);
      });
    }

    var pointerType = '';

    on(rack, 'pointerdown', function (event) {
      pointerType = event.pointerType || '';
    }, true);

    function isTouch() {
      return pointerType ? pointerType !== 'mouse' : !fineHover;
    }

    function isScrolling() {
      return !desktopMq.matches || section.classList.contains('hrs-is-overflowing');
    }

    function rackEdge() {
      var rect = rack.getBoundingClientRect();
      var style = window.getComputedStyle(rack);
      return isRtl ? rect.right - parseFloat(style.paddingRight) : rect.left + parseFloat(style.paddingLeft);
    }

    function itemOffset(state) {
      var rect = state.el.getBoundingClientRect();
      return isRtl ? rect.right - rackEdge() : rect.left - rackEdge();
    }

    function scrollToItem(index) {
      var state = states[index];
      if (!state) return;
      rack.scrollBy({ left: itemOffset(state), behavior: reduceMotion ? 'auto' : 'smooth' });
    }

    function isFullyVisible(state) {
      var rect = state.el.getBoundingClientRect();
      var box = rack.getBoundingClientRect();
      return rect.left >= box.left - 1 && rect.right <= box.right + 1;
    }

    var holdUntil = 0;

    function holdAutoplay(ms) {
      holdUntil = Date.now() + (ms || 5000);
    }

    states.forEach(function (state) {
      on(state.el, 'click', function (event) {
        if (isTouch() && turned !== state && state.canTurn && event.detail !== 0) {
          event.preventDefault();
          holdAutoplay(6000);
          turn(state);
          if (isScrolling()) {
            later(function () {
              if (turned === state && !isFullyVisible(state)) scrollToItem(state.index);
            }, settings.turnMs);
          }
          return;
        }
        if (!settings.popup || !popup) return;
        event.preventDefault();
        openPopup(state);
      });

      on(state.el, 'keydown', function (event) {
        if (!settings.popup || !popup) return;
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openPopup(state);
        }
      });

      on(state.el, 'focus', function () {
        if (!isTouch() && !popupState) turn(state);
      });

      on(state.el, 'blur', function () {
        if (turned === state && !popupState && !state.el.matches(':hover')) turn(null);
      });
    });

    on(document, 'pointerdown', function (event) {
      if (!turned || popupState || event.pointerType === 'mouse') return;
      var item = event.target.closest ? event.target.closest('[data-hrs-item]') : null;
      if (!item || items.indexOf(item) === -1) turn(null);
    }, true);

    var dotsWrap = section.querySelector('[data-hrs-dots]');
    var dots = Array.prototype.slice.call(section.querySelectorAll('[data-hrs-dot]'));
    var dotFrame = 0;

    function atEnd() {
      return Math.abs(rack.scrollLeft) + rack.clientWidth >= rack.scrollWidth - 4;
    }

    function nearestIndex() {
      if (Math.abs(rack.scrollLeft) > 4 && atEnd()) return states.length - 1;
      var best = 0;
      var bestDistance = Infinity;
      states.forEach(function (state) {
        var distance = Math.abs(itemOffset(state));
        if (distance < bestDistance) {
          bestDistance = distance;
          best = state.index;
        }
      });
      return best;
    }

    function updateDots() {
      dotFrame = 0;
      if (!dots.length || !isScrolling()) return;
      var active = nearestIndex();
      dots.forEach(function (dot, index) {
        dot.classList.toggle('hrs-is-on', index === active);
        dot.setAttribute('aria-current', index === active ? 'true' : 'false');
      });
    }

    on(rack, 'scroll', function () {
      if (!dotFrame) dotFrame = requestAnimationFrame(updateDots);
    }, { passive: true });

    on(rack, 'touchstart', function () {
      holdAutoplay(6000);
    }, { passive: true });

    dots.forEach(function (dot, index) {
      on(dot, 'click', function () {
        holdAutoplay(8000);
        if (turned) turn(null);
        scrollToItem(index);
      });
    });

    function autoplayTick() {
      if (desktopMq.matches || !sectionVisible || document.hidden || popupState || Date.now() < holdUntil) return;
      if (rack.scrollWidth <= rack.clientWidth + 4) return;
      if (turned) {
        turn(null);
        return;
      }
      if (atEnd()) scrollToItem(0);
      else scrollToItem(Math.min(states.length - 1, nearestIndex() + 1));
    }

    var autoplayTimer = settings.autoplay && !reduceMotion ? setInterval(autoplayTick, settings.autoplayMs) : null;

    var layoutFrame = 0;
    var curve = section.querySelector('[data-hrs-curve]');
    var curveWidth = 0;
    var bent = false;
    var bendUntil = 0;
    var bendFrame = 0;

    function bend() {
      var active = !!curve && desktopMq.matches && !section.classList.contains('hrs-is-overflowing');
      if (!active) {
        if (bent) {
          bent = false;
          curveWidth = 0;
          rack.style.removeProperty('--hrs-sag');
          states.forEach(function (state) {
            state.el.style.removeProperty('--hrs-dy');
          });
        }
        return;
      }
      bent = true;
      var width = section.clientWidth;
      var half = width / 2;
      var sag = Math.round(width * 0.035);
      var center = rack.parentNode.clientWidth / 2 - rack.offsetLeft;
      var centers = states.map(function (state) {
        return state.el.offsetLeft + state.el.offsetWidth / 2 - center;
      });
      states.forEach(function (state, index) {
        var ratio = centers[index] / half;
        state.el.style.setProperty('--hrs-dy', Math.max(0, sag * (1 - ratio * ratio)).toFixed(2) + 'px');
      });
      if (width === curveWidth) return;
      curveWidth = width;
      rack.style.setProperty('--hrs-sag', sag + 'px');
      curve.setAttribute('viewBox', '0 0 ' + width + ' ' + (sag + 8));
      curve.style.width = width + 'px';
      curve.style.height = sag + 8 + 'px';
      Array.prototype.forEach.call(curve.querySelectorAll('path'), function (path) {
        var y = 4 + parseFloat(path.getAttribute('data-hrs-offset'));
        path.setAttribute('d', 'M0 ' + y + 'Q' + half + ' ' + (y + sag * 2) + ' ' + width + ' ' + y);
      });
    }

    function bendStep() {
      bendFrame = 0;
      if (dead) return;
      bend();
      if (bent && performance.now() < bendUntil) bendFrame = requestAnimationFrame(bendStep);
    }

    function bendFor(ms) {
      if (!curve) return;
      bendUntil = Math.max(bendUntil, performance.now() + ms);
      if (!bendFrame) bendFrame = requestAnimationFrame(bendStep);
    }

    function fitWholeGarments(avail, height, gap, sum) {
      if (!sum || height * sum + gap * (states.length - 1) <= avail + 1) return 0;
      var sides = states.map(function (state) { return state.side; }).sort(function (a, b) { return a - b; });
      var ratio = sides[Math.floor(sides.length / 2)];
      var count = (avail + gap) / (height * ratio + gap);
      var best = 0;
      var bestChange = Infinity;
      [Math.floor(count), Math.ceil(count)].forEach(function (whole) {
        if (whole < 1) return;
        var fitted = (avail - gap * (whole - 1)) / (whole * ratio);
        var change = fitted / height - 1;
        if (change > 0.12 || change < -0.25 || Math.abs(change) >= bestChange) return;
        bestChange = Math.abs(change);
        best = fitted;
      });
      return best;
    }

    function layout() {
      layoutFrame = 0;
      if (dead || !section.clientWidth) return;
      section.style.setProperty('--hrs-section-width', section.clientWidth + 'px');
      rack.style.removeProperty('--hrs-h');
      var overflowing = false;
      var style = window.getComputedStyle(rack);
      var height = parseFloat(style.getPropertyValue('--hrs-h')) || 300;
      var gap = parseFloat(style.columnGap) || 0;
      var sum = 0;
      var widest = 0;
      states.forEach(function (state) {
        sum += state.side;
        widest = Math.max(widest, state.front - state.side);
      });
      if (desktopMq.matches) {
        var spare = rack.clientWidth - gap * (states.length - 1) - 44;
        if (sum + widest > 0 && height * (sum + widest) > spare) {
          var fit = spare / (sum + widest);
          var floor = Math.min(height, 200);
          overflowing = fit < floor;
          if (overflowing) {
            var whole = fitWholeGarments(rack.clientWidth - 24, floor, gap, sum);
            rack.style.setProperty('--hrs-h', (whole ? Math.floor(whole * 10) / 10 : floor) + 'px');
          } else {
            rack.style.setProperty('--hrs-h', fit.toFixed(1) + 'px');
          }
        }
      } else {
        var fitted = fitWholeGarments(rack.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight), height, gap, sum);
        if (fitted) rack.style.setProperty('--hrs-h', (Math.floor(fitted * 10) / 10) + 'px');
      }
      section.classList.toggle('hrs-is-overflowing', overflowing);
      bend();
      bendFor(settings.turnMs + 80);
      if (dotsWrap) dotsWrap.classList.toggle('hrs-is-hidden', rack.scrollWidth <= rack.clientWidth + 4);
      updateDots();
    }

    function queueLayout() {
      if (!layoutFrame) layoutFrame = requestAnimationFrame(layout);
    }

    on(window, 'resize', queueLayout);

    var lastWidth = 0;
    var resizeObserver = null;
    if ('ResizeObserver' in window) {
      resizeObserver = new ResizeObserver(function (entries) {
        var width = entries[0].contentRect.width;
        if (Math.abs(width - lastWidth) < 1) return;
        lastWidth = width;
        queueLayout();
      });
      resizeObserver.observe(section);
    }
    on(desktopMq, 'change', function () {
      turn(null);
      queueLayout();
    });
    layout();

    var dropped = !(settings.dropIn && firstRun) || reduceMotion || !canAnimate || !('IntersectionObserver' in window);
    if (dropped) section.classList.remove(preClass);

    var trimCache = window.hrsTrim = window.hrsTrim || {};
    var trimsPending = 0;
    var trimWaiters = [];

    function firstOpaqueRow(probe) {
      var w = probe.naturalWidth;
      var h = probe.naturalHeight;
      var canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      var context = canvas.getContext('2d', { willReadFrequently: true });
      context.drawImage(probe, 0, 0, w, h);
      var rows = Math.ceil(h * 0.4);
      var pixels = context.getImageData(0, 0, w, rows).data;
      for (var y = 0; y < rows; y++) {
        for (var i = y * w * 4 + 3; i < (y + 1) * w * 4; i += 4) {
          if (pixels[i] > 16) return y / h;
        }
      }
      return 0;
    }

    function trimImage(img, done) {
      var src = img.currentSrc || img.src;
      if (!src) {
        done();
        return;
      }
      var key = src.split('?')[0];
      var apply = function (fraction) {
        if (fraction > 0.004) img.style.transform = 'translateY(-' + (fraction * 100).toFixed(2) + '%)';
        done();
      };
      var cached = trimCache[key];
      if (typeof cached === 'number') {
        apply(cached);
        return;
      }
      if (cached) {
        cached.push(apply);
        return;
      }
      var waiting = trimCache[key] = [apply];
      var settle = function (fraction) {
        trimCache[key] = fraction;
        waiting.forEach(function (fn) { fn(fraction); });
      };
      var probe = new Image();
      probe.crossOrigin = 'anonymous';
      probe.onload = function () {
        var fraction = 0;
        try {
          fraction = firstOpaqueRow(probe);
        } catch (error) {
          fraction = 0;
        }
        settle(fraction);
      };
      probe.onerror = function () {
        settle(0);
      };
      try {
        var url = new URL(src, window.location.href);
        url.searchParams.set('width', '100');
        url.searchParams.delete('height');
        probe.src = url.toString();
      } catch (error) {
        settle(0);
      }
    }

    Array.prototype.forEach.call(rack.querySelectorAll('img.hrs-img-{{ section.id }}'), function (img) {
      trimsPending += 1;
      trimImage(img, function () {
        trimsPending -= 1;
