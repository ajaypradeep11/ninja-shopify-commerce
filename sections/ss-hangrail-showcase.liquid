{%- liquid
  assign padding_horizontal = section.settings.padding_horizontal
  assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign border_color = section.settings.border_color
  assign border_thickness = section.settings.border_thickness
  assign margin_top = section.settings.margin_top
  assign margin_bottom = section.settings.margin_bottom
  assign margin_horizontal_mobile = section.settings.margin_horizontal_mobile
  assign margin_horizontal = section.settings.margin_horizontal
  assign background_color = section.settings.background_color
  assign background_gradient = section.settings.background_gradient
  assign width = section.settings.width
  assign content_width = section.settings.content_width
  assign section_radius = section.settings.section_radius
  assign background_style = section.settings.background_style
  assign lazy = section.settings.lazy

  assign garment_height = section.settings.garment_height
  assign garment_height_mobile = section.settings.garment_height_mobile
  assign garment_gap = section.settings.garment_gap
  assign garment_gap_mobile = section.settings.garment_gap_mobile
  assign show_rod = section.settings.show_rod
  assign rail_finish = section.settings.rail_finish
  assign rail_style = section.settings.rail_style
  assign hanger_hooks = section.settings.hanger_hooks

  assign show_tags = section.settings.show_tags
  assign show_tag_status = section.settings.show_tag_status
  assign tag_sale_label = section.settings.tag_sale_label
  assign tag_custom = section.settings.tag_custom
  assign tag_font = section.settings.tag_font
  assign tag_size = section.settings.tag_size
  assign tag_size_mobile = section.settings.tag_size_mobile

  assign turn_speed = section.settings.turn_speed
  assign swing_strength = section.settings.swing_strength
  assign drop_in = section.settings.drop_in

  assign show_popup = section.settings.show_popup
  assign lift_animation = section.settings.lift_animation
  assign front_label = section.settings.front_label
  assign back_label = section.settings.back_label
  assign link_label = section.settings.link_label
  assign show_quickadd = section.settings.show_quickadd
  assign atc_label = section.settings.atc_label
  assign soldout_label = section.settings.soldout_label
  assign atc_error_label = section.settings.atc_error_label
  assign cart_app = section.settings.cart_app
  assign atc_button_style = section.settings.atc_button_style
  assign atc_button_custom = section.settings.atc_button_custom
  assign atc_button_font = section.settings.atc_button_font
  assign atc_button_size = section.settings.atc_button_size
  assign atc_button_size_mobile = section.settings.atc_button_size_mobile
  assign atc_button_height = section.settings.atc_button_height
  assign atc_button_padding_horizontal = section.settings.atc_button_padding_horizontal
  assign atc_button_padding_horizontal_mobile = section.settings.atc_button_padding_horizontal_mobile
  assign atc_button_padding_vertical = section.settings.atc_button_padding_vertical
  assign atc_button_padding_vertical_mobile = section.settings.atc_button_padding_vertical_mobile
  assign atc_button_radius = section.settings.atc_button_radius
  assign atc_button_border_thickness = section.settings.atc_button_border_thickness
  assign atc_button_custom_styling = section.settings.atc_button_custom_styling

  assign popup_title_custom = section.settings.popup_title_custom
  assign popup_title_font = section.settings.popup_title_font
  assign popup_title_size = section.settings.popup_title_size
  assign popup_title_size_mobile = section.settings.popup_title_size_mobile
  assign popup_title_height = section.settings.popup_title_height
  assign popup_text_custom = section.settings.popup_text_custom
  assign popup_text_font = section.settings.popup_text_font
  assign popup_text_size = section.settings.popup_text_size
  assign popup_text_size_mobile = section.settings.popup_text_size_mobile
  assign popup_text_height = section.settings.popup_text_height

  assign autoplay = section.settings.autoplay
  assign autoplay_speed = section.settings.autoplay_speed
  assign show_dots = section.settings.show_dots

  assign rod_color = section.settings.rod_color
  assign hook_color = section.settings.hook_color
  assign tag_bg_color = section.settings.tag_bg_color
  assign tag_text_color = section.settings.tag_text_color
  assign tag_status_bg_color = section.settings.tag_status_bg_color
  assign tag_status_text_color = section.settings.tag_status_text_color
  assign popup_bg_color = section.settings.popup_bg_color
  assign popup_bg_opacity = section.settings.popup_bg_opacity
  assign popup_title_color = section.settings.popup_title_color
  assign popup_text_color = section.settings.popup_text_color
  assign popup_accent_color = section.settings.popup_accent_color
  assign popup_accent_text_color = section.settings.popup_accent_text_color
  assign popup_border_color = section.settings.popup_border_color
  assign atc_button_color = section.settings.atc_button_color
  assign atc_button_hover_color = section.settings.atc_button_hover_color
  assign atc_button_bg_color = section.settings.atc_button_bg_color
  assign atc_button_bg_hover_color = section.settings.atc_button_bg_hover_color
  assign atc_button_border_color = section.settings.atc_button_border_color
  assign atc_button_border_hover_color = section.settings.atc_button_border_hover_color
  assign atc_button_shadow_color = section.settings.atc_button_shadow_color
  assign dot_color = section.settings.dot_color
  assign dot_active_color = section.settings.dot_active_color

  case rail_finish
    when 'steel'
      assign rail_hi = '#D2D2D0'
      assign rail_light = '#BEBFBC'
      assign rail_base = '#A6A7A4'
      assign rail_shade = '#7D7D7B'
      assign rail_edge = '#5A5A58'
      assign hook_tone = '#8C8D8A'
    when 'gold'
      assign rail_hi = '#FFF6D8'
      assign rail_light = '#F1D281'
      assign rail_base = '#D1A643'
      assign rail_shade = '#A27622'
      assign rail_edge = '#6A4910'
      assign hook_tone = '#B38A2E'
    when 'bronze'
      assign rail_hi = '#F7DCBC'
      assign rail_light = '#D7A673'
      assign rail_base = '#A6723E'
      assign rail_shade = '#784C24'
      assign rail_edge = '#4A2D13'
      assign hook_tone = '#8E5F31'
    when 'rose_gold'
      assign rail_hi = '#FFEDE6'
      assign rail_light = '#EDBDAB'
      assign rail_base = '#C98D7A'
      assign rail_shade = '#9E6251'
      assign rail_edge = '#693C30'
      assign hook_tone = '#B27765'
    when 'black'
      assign rail_hi = '#6A6A6A'
      assign rail_light = '#444444'
      assign rail_base = '#2C2C2C'
      assign rail_shade = '#1D1D1D'
      assign rail_edge = '#111111'
      assign hook_tone = '#2C2C2C'
    when 'white'
      assign rail_hi = '#FFFFFF'
      assign rail_light = '#F7F7F7'
      assign rail_base = '#E6E6E6'
      assign rail_shade = '#C9C9C9'
      assign rail_edge = '#A3A3A3'
      assign hook_tone = '#BDBDBD'
    when 'wood'
      assign rail_hi = '#E4C8A0'
      assign rail_light = '#D9B98B'
      assign rail_base = '#C69C69'
      assign rail_shade = '#A27849'
      assign rail_edge = '#7A5531'
      assign hook_tone = '#8E9399'
    when 'custom'
      assign rail_hi = rod_color | color_lighten: 30
      assign rail_light = rod_color | color_lighten: 12
      assign rail_base = rod_color
      assign rail_shade = rod_color | color_darken: 20
      assign rail_edge = rod_color | color_darken: 32
      assign hook_tone = hook_color
    else
      assign rail_hi = '#FFFFFF'
      assign rail_light = '#DDE1E5'
      assign rail_base = '#B3B8BE'
      assign rail_shade = '#868B92'
      assign rail_edge = '#6E737A'
      assign hook_tone = '#8E9399'
  endcase

  assign loading_attribute = 'lazy'
  if section.index <= 1 or lazy == false
    assign loading_attribute = 'eager'
  endif

  assign product_count = 0
  for block in section.blocks
    if block.type == 'product'
      assign product_count = product_count | plus: 1
    endif
  endfor
-%}

{%- capture img_class -%}hrs-img-{{ section.id }}{%- endcapture -%}
{%- capture placeholder_class -%}hrs-placeholder-{{ section.id }}{%- endcapture -%}

{%- style -%}
  .section-{{ section.id }} {
    border-top: solid {{ border_color }} {{ border_thickness }}px;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px;
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px;
    margin-left: {{ margin_horizontal_mobile }}rem;
    margin-right: {{ margin_horizontal_mobile }}rem;
    border-radius: {{ section_radius | times: 0.6 | round: 0 }}px;
    overflow: hidden;
  }

  .section-{{ section.id }}-settings {
    margin: 0 auto;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ padding_horizontal_mobile }}rem;
    padding-right: {{ padding_horizontal_mobile }}rem;
  }

  .hrs-stage-{{ section.id }} {
    position: relative;
  }

  .hrs-rod-{{ section.id }} {
    position: absolute;
    top: 14px;
    left: 50%;
    z-index: 0;
    display: block !important;
    width: var(--hrs-section-width, 100vw);
    height: 6px;
    border-radius: 6px;
    background: linear-gradient(180deg, {{ rail_shade }} 0%, {{ rail_light }} 14%, {{ rail_hi }} 30%, {{ rail_light }} 42%, {{ rail_base }} 58%, {{ rail_shade }} 78%, {{ rail_base }} 90%, {{ rail_edge }} 100%);
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.12), 0 4px 6px -1px rgba(0, 0, 0, 0.2);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .hrs-rod-end-{{ section.id }} {
    position: absolute;
    top: 50%;
    display: block !important;
    width: 12px;
    height: 20px;
    border-radius: 3px;
    background: linear-gradient(90deg, {{ rail_shade }} 0%, {{ rail_light }} 22%, {{ rail_hi }} 38%, {{ rail_base }} 55%, {{ rail_shade }} 78%, {{ rail_edge }} 100%);
    box-shadow: inset 0 1px 0 {{ rail_hi | color_modify: 'alpha', 0.5 }}, inset 0 -1px 0 rgba(0, 0, 0, 0.18), 0 2px 5px rgba(0, 0, 0, 0.22);
    transform: translateY(-50%);
  }

  .hrs-rod-end-{{ section.id }}::before,
  .hrs-rod-end-{{ section.id }}::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, {{ rail_light }} 0%, {{ rail_edge }} 75%);
    box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.25);
    transform: translateX(-50%);
  }

  .hrs-rod-end-{{ section.id }}::before {
    top: 3px;
  }

  .hrs-rod-end-{{ section.id }}::after {
    bottom: 3px;
  }

  .hrs-rod-end-{{ section.id }}:first-child {
    left: 8px;
  }

  .hrs-rod-end-{{ section.id }}:last-child {
    right: 8px;
  }

  .hrs-rack-{{ section.id }} {
    --hrs-h: {{ garment_height_mobile }}px;
    --hrs-lift: 6.5px;
    --hrs-rail-r: 3px;
    --hrs-turn: {{ turn_speed }}ms;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: {{ garment_gap_mobile }}px;
    margin: 0 -{{ padding_horizontal_mobile }}rem;
    padding: 14px {{ padding_horizontal_mobile }}rem 8px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: {{ padding_horizontal_mobile }}rem;
    scrollbar-width: none;
  }

  .hrs-rack-{{ section.id }}::-webkit-scrollbar {
    display: none;
  }

  .hrs-item-{{ section.id }} {
    position: relative;
    flex: 0 0 auto;
    display: block;
    width: calc(var(--hrs-h) * var(--hrs-side));
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    outline: none;
    scroll-snap-align: start;
    transform-origin: 50% 0;
    transition: width var(--hrs-turn) cubic-bezier(0.25, 0.46, 0.45, 0.94), margin var(--hrs-turn) cubic-bezier(0.25, 0.46, 0.45, 0.94);
    -webkit-tap-highlight-color: transparent;
  }

  .hrs-item-{{ section.id }}:first-child {
    margin-inline-start: auto;
  }

  .hrs-item-{{ section.id }}:last-child {
    margin-inline-end: auto;
  }

  .hrs-item-{{ section.id }}.hrs-is-turned {
    width: calc(var(--hrs-h) * var(--hrs-front));
  }

  .hrs-item-{{ section.id }}.hrs-is-live {
    z-index: 2;
  }

  .hrs-item-{{ section.id }}:focus-visible .hrs-garment-{{ section.id }} {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 4px;
  }

  .hrs-pre-{{ section.id }} .hrs-item-{{ section.id }} {
    opacity: 0;
    animation: hrs-reveal-{{ section.id }} 0s 4s forwards;
  }

  @keyframes hrs-reveal-{{ section.id }} {
    to {
      opacity: 1;
    }
  }

  .hrs-swing-{{ section.id }} {
    position: relative;
    display: flow-root;
    transform: rotate(var(--hrs-sw, 0deg));
    transform-origin: 50% 0;
    will-change: transform;
  }

  .hrs-hook-{{ section.id }} {
    position: absolute;
    top: calc(var(--hrs-rail-r) * -1 - var(--hrs-h) * 0.006);
    left: 50%;
    z-index: 1;
    width: calc(var(--hrs-h) * 0.05);
    height: calc(var(--hrs-h) * 0.1);
    color: {{ hook_tone }};
    transform: translateX(-50%);
    overflow: visible;
  }

  .hrs-garment-{{ section.id }} {
    position: relative;
    z-index: 2;
    height: var(--hrs-h);
    margin-top: calc(var(--hrs-lift) * -1);
  }

  .hrs-is-hooked .hrs-garment-{{ section.id }} {
    margin-top: calc(var(--hrs-h) * 0.084 - var(--hrs-rail-r));
  }

  .hrs-view-{{ section.id }} {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    transform-origin: 50% 0;
    pointer-events: none;
  }

  .hrs-img-{{ section.id }} {
    display: block;
    width: auto;
    max-width: none;
    height: 100%;
    -webkit-user-drag: none;
    user-select: none;
  }

  .hrs-view-{{ section.id }} .hrs-placeholder-{{ section.id }} {
    display: block;
    flex: none;
    width: calc(var(--hrs-h) * var(--hrs-side));
    height: 100%;
    border-radius: 6px;
    background-color: #F3F3F3;
  }

  .hrs-view-front-{{ section.id }} .hrs-placeholder-{{ section.id }} {
    width: calc(var(--hrs-h) * var(--hrs-front));
  }

  .hrs-view-front-{{ section.id }} {
    opacity: 0;
  }

  .hrs-tag-{{ section.id }} {
    position: absolute;
    top: calc(var(--hrs-h) * 0.057 - var(--hrs-lift));
    left: 50%;
    z-index: 3;
    display: block !important;
    width: 0;
    height: 0;
    transform: rotate(calc(-22deg - var(--hrs-sw, 0deg) * 0.7));
    transform-origin: 0 0;
    pointer-events: none;
  }

  .hrs-is-hooked .hrs-tag-{{ section.id }} {
    top: calc(var(--hrs-h) * 0.059 - var(--hrs-rail-r));
  }

  .hrs-tag-string-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    display: block !important;
    width: 1px;
    height: calc(var(--hrs-h) * 0.08 + 6px);
    background-color: {{ tag_text_color | color_modify: 'alpha', 0.4 }};
  }

  .hrs-tag-card-{{ section.id }} {
    position: absolute;
    top: calc(var(--hrs-h) * 0.08);
    left: 0;
    display: grid;
    width: max-content;
    transform: translateX(-50%) rotate(16deg);
    transform-origin: 50% 0;
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.3, 1.4, 0.45, 1);
  }

  .hrs-is-live .hrs-tag-flip-{{ section.id }} {
    transform: translateX(-50%) rotate(16deg) rotateY(180deg);
  }

  .hrs-tag-face-{{ section.id }} {
    position: relative;
    grid-area: 1 / 1;
    display: flex !important;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    margin: 0;
    padding: 9px 6px 4px;
    border-radius: 3px 3px 5px 5px;
    background-color: {{ tag_bg_color }};
    color: {{ tag_text_color }};
    font-size: {{ tag_size_mobile }}px;
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.16), inset 0 0 0 1px rgba(0, 0, 0, 0.05);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .hrs-tag-face-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 3px;
    left: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: currentColor;
    opacity: 0.3;
    transform: translateX(-50%);
  }

  .hrs-tag-back-{{ section.id }} {
    background-color: {{ tag_status_bg_color }};
    color: {{ tag_status_text_color }};
    transform: rotateY(180deg);
  }

  .hrs-dots-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }

  .hrs-dots-{{ section.id }}.hrs-is-hidden {
    display: none;
  }

  .hrs-dot-{{ section.id }} {
    position: relative;
    display: block !important;
    width: 6px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background-color: {{ dot_color }};
    cursor: pointer;
    transition: width 0.3s ease, background-color 0.3s ease;
  }

  .hrs-dot-{{ section.id }}::after {
    content: '';
    position: absolute;
    inset: -8px -4px;
  }

  .hrs-dot-{{ section.id }}.hrs-is-on {
    width: 22px;
    background-color: {{ dot_active_color }};
  }

  .hrs-footer-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  {% if show_popup %}
    .hrs-popup-{{ section.id }} {
      position: fixed;
      inset: 0;
      z-index: 2147483000;
      display: none;
      box-sizing: border-box;
      padding: 64px 16px 32px;
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
      color: {{ popup_text_color }};
      font-size: {{ popup_text_size_mobile }}px;
      font-weight: 400;
      line-height: {{ popup_text_height }}%;
      text-align: center;
    }

    .hrs-popup-{{ section.id }}.hrs-is-open {
      display: flex;
    }

    .hrs-popup-{{ section.id }} [hidden] {
      display: none !important;
    }

    .hrs-popup-bg-{{ section.id }} {
      position: fixed;
      inset: 0;
      display: block !important;
      background-color: {{ popup_bg_color }};
      background-color: {{ popup_bg_color | color_modify: 'alpha', popup_bg_opacity }};
      -webkit-backdrop-filter: blur(24px);
      backdrop-filter: blur(24px);
      opacity: 0;
      transition: opacity 0.35s ease;
    }

    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
      .hrs-popup-bg-{{ section.id }} {
        background-color: {{ popup_bg_color }};
      }
    }

    .hrs-popup-{{ section.id }}.hrs-is-visible .hrs-popup-bg-{{ section.id }} {
      opacity: 1;
    }

    .hrs-popup-close-{{ section.id }} {
      position: fixed;
      top: 12px;
      inset-inline-end: 12px;
      z-index: 3;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: {{ popup_title_color }};
      cursor: pointer;
      opacity: 0;
      transition: opacity 0.25s ease;
    }

    .hrs-popup-close-{{ section.id }} svg {
      width: 20px;
      height: 20px;
    }

    .hrs-popup-inner-{{ section.id }} {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      width: 100%;
      max-width: 1100px;
      margin: auto;
    }

    .hrs-popup-stage-{{ section.id }} {
      --hrs-ph: min(46vh, 440px);
      position: relative;
      flex: 0 0 auto;
      width: calc(var(--hrs-ph) * var(--hrs-pr, 0.75));
      max-width: 100%;
      height: var(--hrs-ph);
      perspective: 1600px;
      transform-origin: 50% 0;
      cursor: grab;
      touch-action: pan-y;
      user-select: none;
    }

    .hrs-popup-stage-{{ section.id }}.hrs-no-back {
      cursor: default;
    }

    .hrs-popup-stage-{{ section.id }}.hrs-is-dragging {
      cursor: grabbing;
    }

    .hrs-popup-card-{{ section.id }} {
      position: absolute;
      inset: 0;
      display: block !important;
      transform-style: preserve-3d;
    }

    .hrs-popup-face-{{ section.id }} {
      position: absolute;
      inset: 0;
      display: flex !important;
      align-items: center;
      justify-content: center;
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
    }

    .hrs-popup-face-{{ section.id }} img,
    .hrs-popup-face-{{ section.id }} svg {
      display: block;
      width: 100%;
      max-width: none;
      height: 100%;
      object-fit: contain;
      pointer-events: none;
      -webkit-user-drag: none;
    }

    .hrs-popup-face-{{ section.id }} .hrs-placeholder-{{ section.id }} {
      border-radius: 8px;
      background-color: #F3F3F3;
    }

    .hrs-popup-back-{{ section.id }} {
      transform: rotateY(180deg);
    }

    .hrs-popup-meta-{{ section.id }} {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 420px;
      opacity: 0;
      transition: opacity 0.2s ease;
    }

    .hrs-popup-{{ section.id }}.hrs-is-visible .hrs-popup-close-{{ section.id }},
    .hrs-popup-{{ section.id }}.hrs-is-visible .hrs-popup-meta-{{ section.id }} {
      opacity: 1;
      transition: opacity 0.35s ease 0.2s;
    }

    .hrs-popup-index-{{ section.id }} {
      margin: 0 0 6px;
      font-size: {{ popup_text_size_mobile | times: 0.8 | round: 0 }}px;
      line-height: {{ popup_text_height }}%;
    }

    .hrs-popup-title-{{ section.id }} {
      margin: 0;
      font-size: {{ popup_title_size_mobile }}px;
      font-weight: 700;
      line-height: {{ popup_title_height }}%;
      color: {{ popup_title_color }};
      text-transform: unset;
      word-break: break-word;
    }

    .hrs-popup-price-{{ section.id }} {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin: 8px 0 0;
      color: {{ popup_title_color }};
    }

    .hrs-popup-tabs-{{ section.id }} {
      display: flex;
      justify-content: center;
      gap: 24px;
      margin-top: 14px;
    }

    .hrs-popup-tab-{{ section.id }} {
      position: relative;
      padding: 4px 2px 8px;
      border: 0;
      background: none;
      color: {{ popup_text_color }};
      font-family: inherit;
      font-size: {{ popup_text_size_mobile }}px;
      font-weight: inherit;
      cursor: pointer;
      transition: color 0.2s ease;
    }

    .hrs-popup-tab-{{ section.id }}::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      right: 50%;
      height: 2px;
      border-radius: 2px;
      background-color: {{ popup_accent_color }};
      transition: left 0.25s ease, right 0.25s ease;
    }

    .hrs-popup-tab-{{ section.id }}.hrs-is-on {
      color: {{ popup_title_color }};
    }

    .hrs-popup-tab-{{ section.id }}.hrs-is-on::after {
      left: 0;
      right: 0;
    }

    .hrs-popup-options-{{ section.id }} {
      margin-top: 18px;
    }

    .hrs-popup-option-{{ section.id }} + .hrs-popup-option-{{ section.id }} {
      margin-top: 14px;
    }

    .hrs-popup-option-name-{{ section.id }} {
      margin: 0 0 8px;
      font-size: {{ popup_text_size_mobile | times: 0.85 | round: 0 }}px;
      line-height: {{ popup_text_height }}%;
    }

    .hrs-popup-pills-{{ section.id }} {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
    }

    .hrs-popup-pill-{{ section.id }} {
      min-width: 44px;
      height: 40px;
      padding: 0 14px;
      border: 1px solid {{ popup_border_color }};
      border-radius: 40px;
      background-color: transparent;
      color: {{ popup_title_color }};
      font-family: inherit;
      font-size: {{ popup_text_size_mobile }}px;
      font-weight: inherit;
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    .hrs-popup-pill-{{ section.id }}[aria-pressed="true"] {
      border-color: {{ popup_accent_color }};
      background-color: {{ popup_accent_color }};
      color: {{ popup_accent_text_color }};
    }

    .hrs-popup-pill-{{ section.id }}.hrs-is-na {
      opacity: 0.45;
      text-decoration: line-through;
    }

    .hrs-popup-atc-{{ section.id }} {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      margin: 18px 0 0;
      padding: {{ atc_button_padding_vertical_mobile }}px {{ atc_button_padding_horizontal_mobile }}px;
      font-family: inherit;
      font-size: {{ atc_button_size_mobile }}px;
      font-weight: 700;
      line-height: {{ atc_button_height }}%;
      color: {{ atc_button_color }};
      text-align: center;
      text-transform: unset;
      text-decoration: none;
      border: 0px;
      border-radius: {{ atc_button_radius }}px;
      background-color: transparent;
      cursor: pointer;
      transition: all 0.25s ease 0s;
      {% if atc_button_custom_styling and atc_button_style != 'link' %}
        position: relative;
        overflow: hidden;
      {% endif %}
    }

    {% if atc_button_custom_styling and atc_button_style != 'link' %}
      .hrs-popup-atc-{{ section.id }} {
        background: linear-gradient(180deg, {{ atc_button_bg_color | color_lighten: 4 }}, {{ atc_button_bg_color | color_darken: 10 }});
        box-shadow: 0 14px 30px {{ atc_button_shadow_color | color_modify: 'alpha', 0.28 }}, 0 5px 12px {{ atc_button_shadow_color | color_modify: 'alpha', 0.2 }}, inset 0 1px 0 #ffffff26;
        backdrop-filter: saturate(1.05);
      }

      .hrs-popup-atc-{{ section.id }}::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
        transition: left 0.6s ease;
      }

      .hrs-popup-atc-{{ section.id }}:not(:disabled):hover::before {
        left: 100%;
      }

      .hrs-popup-atc-{{ section.id }}:not(:disabled):hover {
        color: {{ atc_button_hover_color }};
        background: linear-gradient(180deg, {{ atc_button_bg_hover_color | color_lighten: 4 }}, {{ atc_button_bg_hover_color | color_darken: 10 }});
        transform: translateY(-2px);
        box-shadow: 0 18px 36px {{ atc_button_shadow_color | color_modify: 'alpha', 0.34 }}, 0 7px 16px {{ atc_button_shadow_color | color_modify: 'alpha', 0.24 }}, inset 0 1px 0 #ffffff33;
      }

      .hrs-popup-atc-{{ section.id }}:not(:disabled):active {
        transform: translateY(1px);
        filter: brightness(1.00208);
        box-shadow: 0 4px 8px {{ atc_button_shadow_color | color_modify: 'alpha', 0.3 }}, 0 2px 4px {{ atc_button_shadow_color | color_modify: 'alpha', 0.2 }}, inset 0 1px 0 #ffffff0d, inset 0 -1px 0 {{ atc_button_shadow_color | color_modify: 'alpha', 0.2 }};
      }
    {% else %}
      .hrs-popup-atc-{{ section.id }}:not(:disabled):hover {
        color: {{ atc_button_hover_color }};
      }
    {% endif %}

    .hrs-popup-atc-{{ section.id }} svg {
      width: 14px !important;
      height: 14px !important;
      background: transparent;
      min-height: auto !important;
      flex: none;
    }

    .hrs-popup-atc-{{ section.id }}:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .hrs-popup-spinner-{{ section.id }} {
      display: none;
      width: 16px;
      height: 16px;
      border: 2px solid currentColor;
      border-right-color: transparent;
      border-radius: 50%;
      animation: hrs-spin-{{ section.id }} 0.7s linear infinite;
    }

    .hrs-popup-atc-{{ section.id }}.hrs-is-busy .hrs-popup-spinner-{{ section.id }} {
      display: block !important;
    }

    @keyframes hrs-spin-{{ section.id }} {
      to {
        transform: rotate(360deg);
      }
    }

    .hrs-popup-error-{{ section.id }} {
      margin: 10px 0 0;
      font-size: {{ popup_text_size_mobile | times: 0.85 | round: 0 }}px;
      line-height: {{ popup_text_height }}%;
      color: #D72C0D;
    }

    .hrs-popup-link-{{ section.id }} {
      position: relative;
      display: inline-block;
      margin-top: 16px;
      color: {{ popup_title_color }};
      font-size: {{ popup_text_size_mobile }}px;
      text-decoration: none;
    }

    .hrs-popup-link-{{ section.id }}::after {
      content: '';
      position: absolute;
      bottom: -2px;
      inset-inline-start: 0;
      width: 0;
      height: 1px;
      background-color: currentColor;
      transition: width 0.25s ease;
    }

    .hrs-popup-link-{{ section.id }}:focus-visible::after {
      width: 100%;
    }

    @media (hover: hover) {
      .hrs-popup-pill-{{ section.id }}:hover {
        border-color: {{ popup_accent_color }};
      }

      .hrs-popup-link-{{ section.id }}:hover::after {
        width: 100%;
      }
    }

    .hrs-fly-{{ section.id }} {
      position: fixed;
      z-index: 2147483001;
      margin: 0;
      object-fit: contain;
      pointer-events: none;
      filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.2));
    }
  {% endif %}

  @media(min-width: 1024px) {
    .section-{{ section.id }} {
      margin-top: {{ margin_top }}px;
      margin-bottom: {{ margin_bottom }}px;
      margin-left: {{ margin_horizontal }}rem;
      margin-right: {{ margin_horizontal }}rem;
      border-radius: {{ section_radius }}px;
    }

    .section-{{ section.id }}-settings {
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      padding-left: {{ padding_horizontal }}rem;
      padding-right: {{ padding_horizontal }}rem;
    }

    .hrs-rod-{{ section.id }} {
      height: 8px;
    }

    .hrs-rod-end-{{ section.id }} {
      width: 16px;
      height: 28px;
      border-radius: 4px;
    }

    .hrs-rod-end-{{ section.id }}::before,
    .hrs-rod-end-{{ section.id }}::after {
      width: 4px;
      height: 4px;
    }

    .hrs-rod-end-{{ section.id }}::before {
      top: 4px;
    }

    .hrs-rod-end-{{ section.id }}::after {
      bottom: 4px;
    }

    .hrs-rod-end-{{ section.id }}:first-child {
      left: 16px;
    }

    .hrs-rod-end-{{ section.id }}:last-child {
      right: 16px;
    }

    .hrs-rack-{{ section.id }} {
      --hrs-h: {{ garment_height }}px;
      --hrs-lift: 8px;
      --hrs-rail-r: 4px;
      justify-content: center;
      gap: {{ garment_gap }}px;
      margin: 0;
      padding: 14px 0 8px;
      overflow: visible;
      scroll-snap-type: none;
    }

    .hrs-item-{{ section.id }}:first-child,
    .hrs-item-{{ section.id }}:last-child {
      margin-inline: 0;
    }

    .hrs-item-{{ section.id }}.hrs-can-turn.hrs-is-live {
      margin-inline: 18px;
    }

    .hrs-tag-face-{{ section.id }} {
      min-width: 40px;
      padding: 10px 8px 5px;
      font-size: {{ tag_size }}px;
    }

    .hrs-dots-{{ section.id }} {
      display: none;
    }

    .hrs-is-overflowing .hrs-rack-{{ section.id }} {
      justify-content: flex-start;
      padding-inline: 12px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x proximity;
      scroll-padding-inline: 12px;
    }

    .hrs-is-overflowing .hrs-dots-{{ section.id }} {
      display: flex;
    }

    .hrs-is-overflowing .hrs-dots-{{ section.id }}.hrs-is-hidden {
      display: none;
    }

    {% if show_popup %}
      .hrs-popup-{{ section.id }} {
        padding: 48px 40px;
        font-size: {{ popup_text_size }}px;
        text-align: start;
      }

      .hrs-popup-close-{{ section.id }} {
        top: 20px;
        inset-inline-end: 24px;
      }

      .hrs-popup-inner-{{ section.id }} {
        flex-direction: row;
        justify-content: center;
        gap: clamp(40px, 6vw, 96px);
      }

      .hrs-popup-stage-{{ section.id }} {
        --hrs-ph: min(76vh, 680px);
        max-width: 55vw;
      }

      .hrs-popup-meta-{{ section.id }} {
        max-width: 380px;
      }

      .hrs-popup-index-{{ section.id }} {
        font-size: {{ popup_text_size | times: 0.8 | round: 0 }}px;
      }

      .hrs-popup-title-{{ section.id }} {
        font-size: {{ popup_title_size }}px;
      }

      .hrs-popup-price-{{ section.id }},
      .hrs-popup-tabs-{{ section.id }},
      .hrs-popup-pills-{{ section.id }} {
        justify-content: flex-start;
      }

      .hrs-popup-tab-{{ section.id }},
      .hrs-popup-pill-{{ section.id }},
      .hrs-popup-link-{{ section.id }} {
        font-size: {{ popup_text_size }}px;
      }

      .hrs-popup-atc-{{ section.id }} {
        padding: {{ atc_button_padding_vertical }}px {{ atc_button_padding_horizontal }}px;
        font-size: {{ atc_button_size }}px;
      }

      {% if show_quickadd and atc_button_style != 'link' %}
        .hrs-popup-{{ section.id }} [data-hrs-popup-buy]:not([hidden]) + .hrs-popup-link-{{ section.id }} {
          display: block;
          width: fit-content;
          margin-inline: auto;
        }
      {% endif %}

      .hrs-popup-option-name-{{ section.id }},
      .hrs-popup-error-{{ section.id }} {
        font-size: {{ popup_text_size | times: 0.85 | round: 0 }}px;
      }
    {% endif %}
  }

  @media (prefers-reduced-motion: reduce) {
    .hrs-item-{{ section.id }},
    .hrs-tag-card-{{ section.id }},
    .hrs-popup-bg-{{ section.id }},
    .hrs-popup-meta-{{ section.id }} {
      transition-duration: 0.01ms !important;
      transition-delay: 0s !important;
    }

    .hrs-pre-{{ section.id }} .hrs-item-{{ section.id }} {
      opacity: 1;
      animation: none;
    }
  }
{%- endstyle -%}

{% if width == 'custom' %}
  <style>
    .section-{{ section.id }}-settings {
      max-width: {{ content_width }}px;
    }
  </style>
{% elsif width == 'page' %}
  <style>
    .section-{{ section.id }}-settings {
      max-width: clamp(100px, var(--page-content-width, var(--page-width)), 100%);
    }
  </style>
{% endif %}

{% if margin_horizontal_mobile > 0 %}
  <style>
    .section-{{ section.id }} {
      border-left: solid {{ border_color }} {{ border_thickness }}px;
      border-right: solid {{ border_color }} {{ border_thickness }}px;
    }

    @media(min-width: 1024px) {
      .section-{{ section.id }} {
        border-left: 0px;
        border-right: 0px;
      }
    }
  </style>
{% endif %}

{% if margin_horizontal > 0 %}
  <style>
    @media(min-width: 1024px) {
      .section-{{ section.id }} {
        border-left: solid {{ border_color }} {{ border_thickness }}px;
        border-right: solid {{ border_color }} {{ border_thickness }}px;
      }
    }
  </style>
{% endif %}

{% if show_rod and rail_finish == 'steel' %}
  <style>
    .hrs-rod-{{ section.id }} {
      background: linear-gradient(180deg, #8D8D8B 0%, #BBBBB9 7%, #D2D2D0 14%, #ACADAA 21%, #979895 28%, #AFB0AD 34%, #C0C1BE 41%, #B4B4B2 48%, #979795 55%, #7A7B78 62%, #666764 69%, #6D6E6B 76%, #7F7F7D 86%, #747472 93%, #585856 100%);
    }

    .hrs-rod-end-{{ section.id }} {
      background: linear-gradient(180deg, #BEBEBC 0%, #B2B3B0 100%);
      box-shadow: inset 3px 0 0 #B1B2AF, inset 4px 0 0 #CFCFCD, inset 0 1px 0 rgba(255, 255, 255, 0.45), inset 0 -1px 0 rgba(0, 0, 0, 0.1), 0 2px 5px rgba(0, 0, 0, 0.18);
    }

    .hrs-rod-end-{{ section.id }}::before,
    .hrs-rod-end-{{ section.id }}::after {
      background: radial-gradient(circle, #5E5F5C 0 30%, #8A8B88 55%, #ACADAA 100%);
      box-shadow: 0 0.5px 0 rgba(255, 255, 255, 0.5);
    }
  </style>
{% endif %}

{% if show_rod and rail_finish == 'wood' %}
  <style>
    .hrs-rod-{{ section.id }}::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background-image: repeating-linear-gradient(90deg, rgba(110, 70, 34, 0.32) 0 150px, transparent 150px 240px, rgba(110, 70, 34, 0.2) 240px 330px, transparent 330px 470px), repeating-linear-gradient(90deg, transparent 0 70px, rgba(255, 244, 222, 0.35) 70px 260px, transparent 260px 390px), repeating-linear-gradient(90deg, transparent 0 40px, rgba(110, 70, 34, 0.26) 40px 220px, transparent 220px 300px, rgba(110, 70, 34, 0.16) 300px 360px, transparent 360px 430px);
      background-position: 0 22%, 0 46%, 0 74%;
      background-size: 100% 1px;
      background-repeat: no-repeat;
      pointer-events: none;
    }
  </style>
{% endif %}

{% if show_rod and rail_style == 'curved' %}
  <style>
    .hrs-rod-curve-{{ section.id }} {
      position: absolute;
      top: 0;
      left: 0;
      display: none;
      overflow: visible;
      filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.12)) drop-shadow(0 3px 3px rgba(0, 0, 0, 0.14));
      pointer-events: none;
    }

    @media(min-width: 1024px) {
      .hrs-section-{{ section.id }}:not(.hrs-is-overflowing) .hrs-rod-{{ section.id }} {
        background: none;
        box-shadow: none;
      }
      {% if rail_finish == 'wood' %}
        .hrs-section-{{ section.id }}:not(.hrs-is-overflowing) .hrs-rod-{{ section.id }}::before {
          display: none;
        }
      {% endif %}

      .hrs-section-{{ section.id }}:not(.hrs-is-overflowing) .hrs-rod-curve-{{ section.id }} {
        display: block;
      }

      .hrs-rack-{{ section.id }} {
