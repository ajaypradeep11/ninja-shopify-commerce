    }

    function addToCart(variantId) {
      if (busy || !variantId) return;
      busy = true;
      var addedState = popupState;
      atcButton.disabled = true;
      atcButton.classList.add('hrs-is-busy');
      if (errorEl) errorEl.textContent = '';

      var cartApp = atcButton.getAttribute('data-cart-app') || 'auto-detect';
      var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      var cartEl = document.querySelector('cart-drawer, cart-notification');
      var sections;
      if (cartEl && typeof cartEl.getSectionsToRender === 'function') {
        sections = cartEl.getSectionsToRender().map(function (s) { return s.id; });
      } else {
        sections = ['cart-notification', 'cart-drawer', 'cart-icon-bubble'];
      }
      document.querySelectorAll('cart-items-component').forEach(function (item) {
        if (item instanceof HTMLElement && item.dataset.sectionId) sections.push(item.dataset.sectionId);
      });

      fetch(root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ items: [{ id: parseInt(variantId, 10), quantity: 1 }], sections: sections })
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (dead) return;
          var current = popupState === addedState;
          if (data.status) {
            if (current && errorEl) errorEl.textContent = data.description || data.message || settings.errorLabel;
            return;
          }
          var showCart = function () {
            if (popupState && popupState !== addedState) {
              afterClose = showCart;
              return;
            }
            afterClose = null;
            closePopup(true);
            openCart(data, variantId, cartApp);
          };
          if (!current) {
            showCart();
            return;
          }
          atcLabel.textContent = '✓';
          flyToCart();
          later(showCart, 520);
        })
        .catch(function () {
          if (dead) return;
          if (popupState === addedState && errorEl) errorEl.textContent = settings.errorLabel;
        })
        .finally(function () {
          busy = false;
          if (dead) return;
          atcButton.classList.remove('hrs-is-busy');
          later(updateBuy, popupState === addedState ? 900 : 0);
        });
    }

    if (atcButton) {
      on(atcButton, 'click', function (event) {
        event.preventDefault();
        if (currentVariant && currentVariant.available) addToCart(currentVariant.id);
      });
    }

    function select(blockId) {
      var state = states.filter(function (s) { return s.blockId === blockId; })[0];
      if (!state) return;
      if (isScrolling()) {
        holdAutoplay(10000);
        scrollToItem(state.index);
        later(function () {
          if (turned === state && !isFullyVisible(state)) scrollToItem(state.index);
        }, settings.turnMs);
      }
      turn(state);
    }

    function deselect() {
      turn(null);
    }

    function destroy() {
      dead = true;
      if (popupState) document.body.style.overflow = bodyOverflow;
      cleanups.forEach(function (cleanup) { cleanup(); });
      timers.forEach(function (id) { clearTimeout(id); });
      clearTimeout(titleTimer);
      if (autoplayTimer) clearInterval(autoplayTimer);
      if (swingFrame) cancelAnimationFrame(swingFrame);
      if (angleFrame) cancelAnimationFrame(angleFrame);
      if (layoutFrame) cancelAnimationFrame(layoutFrame);
      if (turnFrame) cancelAnimationFrame(turnFrame);
      if (bendFrame) cancelAnimationFrame(bendFrame);
      if (dotFrame) cancelAnimationFrame(dotFrame);
      if (flight) flight.cancel();
      if (observer) observer.disconnect();
      if (resizeObserver) resizeObserver.disconnect();
      if (popup && popup.parentNode) popup.parentNode.removeChild(popup);
      section._hrs = null;
    }

    section._hrs = { select: select, deselect: deselect, destroy: destroy };
  }

  if (document.readyState !== 'loading') {
    initHrs_{{ section.id | replace: '-', '_' }}();
  } else {
    document.addEventListener('DOMContentLoaded', initHrs_{{ section.id | replace: '-', '_' }});
  }

  if (window.Shopify && Shopify.designMode && !window.hrsEditor_{{ section.id | replace: '-', '_' }}) {
    window.hrsEditor_{{ section.id | replace: '-', '_' }} = true;

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === '{{ section.id }}') initHrs_{{ section.id | replace: '-', '_' }}();
    });

    document.addEventListener('shopify:section:unload', function (event) {
      if (event.detail.sectionId !== '{{ section.id }}') return;
      var section = document.querySelector('.hrs-section-{{ section.id }}');
      if (section && section._hrs) section._hrs.destroy();
    });

    document.addEventListener('shopify:block:select', function (event) {
      if (event.detail.sectionId !== '{{ section.id }}') return;
      var section = document.querySelector('.hrs-section-{{ section.id }}');
      if (section && section._hrs) section._hrs.select(event.detail.blockId);
    });

    document.addEventListener('shopify:block:deselect', function (event) {
      if (event.detail.sectionId !== '{{ section.id }}') return;
      var section = document.querySelector('.hrs-section-{{ section.id }}');
      if (section && section._hrs) section._hrs.deselect();
    });
  }
</script>

