    <style>
      {{ atc_button_font | font_face: font_display: 'swap' }}

      .hrs-popup-atc-{{ section.id }} {
        font-family: {{ atc_button_font.family }}, {{ atc_button_font.fallback_families }};
        font-weight: {{ atc_button_font.weight }};
        font-style: {{ atc_button_font.style }};
      }
    </style>
  {% endif %}

  {% if atc_button_style == 'non_outline' or atc_button_style == 'non_outline_arrow' %}
    <style>
      .hrs-popup-atc-{{ section.id }} {
        background-color: {{ atc_button_bg_color }};
      }

      .hrs-popup-atc-{{ section.id }}:not(:disabled):hover {
        background-color: {{ atc_button_bg_hover_color }};
      }
    </style>
  {% elsif atc_button_style == 'outline' or atc_button_style == 'outline_arrow' %}
    <style>
      .hrs-popup-atc-{{ section.id }} {
        background-color: {{ atc_button_bg_color }};
        border: {{ atc_button_border_thickness }}px solid {{ atc_button_border_color }};
      }

      .hrs-popup-atc-{{ section.id }}:not(:disabled):hover {
        background-color: {{ atc_button_bg_hover_color }};
        border: {{ atc_button_border_thickness }}px solid {{ atc_button_border_hover_color }};
      }
