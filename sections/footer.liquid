<footer class="site-footer">
  <div class="container-wide usp-strip">
    {%- if section.settings.usp_1 != blank -%}
      <div class="usp-item">{% render 'icon', name: 'clock' %}<span>{{ section.settings.usp_1 }}</span></div>
    {%- endif -%}
    {%- if section.settings.usp_2 != blank -%}
      <div class="usp-item">{% render 'icon', name: 'undo' %}<span>{{ section.settings.usp_2 }}</span></div>
    {%- endif -%}
    {%- if section.settings.usp_3 != blank -%}
      <div class="usp-item">{% render 'icon', name: 'sparkles' %}<span>{{ section.settings.usp_3 }}</span></div>
    {%- endif -%}
  </div>
  <div class="footer-newsletter"><div class="container-wide footer-newsletter__inner"><div class="footer-newsletter__text"><h2 class="eyebrow">{{ section.settings.newsletter_heading }}</h2><p class="footer-newsletter__sub">{{ section.settings.newsletter_text }}</p></div>{%- form 'customer', class: 'footer-newsletter__form' -%}<input type="hidden" name="contact[tags]" value="newsletter">{%- if form.posted_successfully? -%}<p class="footer-newsletter__msg footer-newsletter__msg--ok">Thanks for subscribing!</p>{%- else -%}<div class="footer-newsletter__row"><input type="email" name="contact[email]" id="footer-newsletter-email" class="footer-newsletter__input" value="{{ form.email }}" placeholder="Your email" required autocomplete="email" aria-label="Email address"><button type="submit" class="footer-newsletter__btn">Subscribe</button></div>{%- if form.errors -%}<p class="footer-newsletter__msg footer-newsletter__msg--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}{%- endif -%}{%- endform -%}</div></div>

  <div class="footer-band">
    <div class="container-wide footer-trust">
      <div>
        <h2 class="eyebrow">Accepted payment</h2>
        <ul class="payment-icons" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- else -%}
            <li class="payment-placeholder">Secure payment</li>
          {%- endfor -%}
        </ul>
      </div>
      <div class="footer-guarantee">
        <h2 class="eyebrow eyebrow--with-icon">{% render 'icon', name: 'shield' %}100% satisfaction guaranteed</h2>
        <p>{{ section.settings.returns_text }}</p>
      </div>
    </div>
  </div>

  <div class="container-wide footer-links">
    <div>
      <h2 class="eyebrow">Shop</h2>
      <ul role="list"><li><a href="{{ routes.all_products_collection_url | append: '?sort_by=best-selling' }}">All products</a></li></ul>
    </div>
    <div>
      <h2 class="eyebrow">Explore</h2>
      <ul role="list">
        {%- for link in section.settings.menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </div>
    <div>
      <h2 class="eyebrow">Policies</h2>
      <ul role="list">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <div class="container-wide footer-contact">
    {%- assign contact_email = settings.contact_email | default: shop.email -%}
    {%- if contact_email != blank -%}<a href="mailto:{{ contact_email }}">{{ contact_email }}</a>{%- endif -%}
  </div>
  <div class="container-wide footer-social">
    <h2 class="eyebrow">Follow</h2>
    <ul class="social-links" role="list">
      <li><a class="social-link" href="https://www.instagram.com/localninja.ca" target="_blank" rel="noopener" aria-label="LocalNinja on Instagram"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.06 1.8.25 2.22.42.56.21.96.47 1.38.89.42.42.68.82.89 1.38.17.42.36 1.05.42 2.22.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.06 1.17-.25 1.8-.42 2.22-.21.56-.47.96-.89 1.38-.42.42-.82.68-1.38.89-.42.17-1.05.36-2.22.42-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.06-1.8-.25-2.22-.42-.56-.21-.96-.47-1.38-.89-.42-.42-.68-.82-.89-1.38-.17-.42-.36-1.05-.42-2.22-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.06-1.17.25-1.8.42-2.22.21-.56.47-.96.89-1.38.42-.42.82-.68 1.38-.89.42-.17 1.05-.36 2.22-.42 1.27-.06 1.65-.07 4.85-.07m0 1.44c-3.15 0-3.52.01-4.76.07-1.15.05-1.77.25-2.19.41-.55.21-.94.47-1.35.88-.41.41-.67.8-.88 1.35-.16.42-.36 1.04-.41 2.19-.06 1.24-.07 1.61-.07 4.76s.01 3.52.07 4.76c.05 1.15.25 1.77.41 2.19.21.55.47.94.88 1.35.41.41.8.67 1.35.88.42.16 1.04.36 2.19.41 1.24.06 1.61.07 4.76.07s3.52-.01 4.76-.07c1.15-.05 1.77-.25 2.19-.41.55-.21.94-.47 1.35-.88.41-.41.67-.8.88-1.35.16-.42.36-1.04.41-2.19.06-1.24.07-1.61.07-4.76s-.01-3.52-.07-4.76c-.05-1.15-.25-1.77-.41-2.19-.21-.55-.47-.94-.88-1.35-.41-.41-.8-.67-1.35-.88-.42-.16-1.04-.36-2.19-.41-1.24-.06-1.61-.07-4.76-.07m0 2.45a5.95 5.95 0 1 1 0 11.9 5.95 5.95 0 0 1 0-11.9m0 1.44a4.51 4.51 0 1 0 0 9.02 4.51 4.51 0 0 0 0-9.02m6.11-2.72a1.39 1.39 0 1 1 0 2.78 1.39 1.39 0 0 1 0-2.78"/></svg></a></li>
      <li><a class="social-link" href="https://www.tiktok.com/@localninja.ca" target="_blank" rel="noopener" aria-label="LocalNinja on TikTok"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M16.87 5.6a4.7 4.7 0 0 1-1.15-3.1h-3.1v12.63a2.62 2.62 0 1 1-2.62-2.62c.27 0 .53.04.78.12V9.44a5.72 5.72 0 1 0 4.94 5.66V8.9a7.75 7.75 0 0 0 4.5 1.44V7.24a4.68 4.68 0 0 1-3.35-1.64Z"/></svg></a></li>
      </ul>
  </div>

  <div class="footer-bottom">
    <div class="container-wide footer-bottom__inner">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>

      {% render 'country-selector', placement: 'footer' %}
    </div>
  </div>
</footer><style>.footer-newsletter { border-bottom: 1px solid #2a2a28; }.footer-newsletter__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; padding-top: 28px; padding-bottom: 28px; }.footer-newsletter__sub { margin: 6px 0 0; opacity: 0.7; }.footer-newsletter__form { flex: 1 1 320px; max-width: 460px; }.footer-newsletter__row { display: flex; gap: 8px; }.footer-newsletter__input { flex: 1 1 auto; min-width: 0; padding: 12px 14px; background: transparent; border: 1px solid #3a3a35; border-radius: 8px; color: inherit; font: inherit; }.footer-newsletter__input:focus { outline: none; border-color: #ffd84d; }.footer-newsletter__btn { padding: 12px 20px; background: #ffd84d; color: #141317; border: 0; border-radius: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 12px; cursor: pointer; }.footer-newsletter__btn:hover { filter: brightness(1.08); }.footer-newsletter__msg--ok { margin: 0; color: #ffd84d; }.footer-newsletter__msg--error { margin: 8px 0 0; color: #ff7a6b; }@media (max-width: 640px) { .footer-newsletter__row { flex-direction: column; } .footer-newsletter__form { max-width: none; } }</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "usp_1",
      "label": "First benefit",
      "default": "Ships in 48 hours"
    },
    {
      "type": "text",
      "id": "usp_2",
      "label": "Second benefit",
      "default": "30-day returns"
    },
    {
      "type": "text",
      "id": "usp_3",
      "label": "Third benefit",
      "default": "16 colors, one remote"
    },
    { "type": "header", "content": "Newsletter signup" },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "Sign up for our newsletter" },
    { "type": "text", "id": "newsletter_text", "label": "Subtext", "default": "Local drops, restocks and deals, straight to your inbox." },  
    {
      "type": "textarea",
      "id": "returns_text",
      "label": "Guarantee text",
      "default": "30-day returns — a full refund to your original payment method, no store credit."
    }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
