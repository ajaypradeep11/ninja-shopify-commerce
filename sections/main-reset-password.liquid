<section class="customer-page">
  <h1>Reset your password</h1>
  {%- form 'reset_customer_password', class: 'form-grid' -%}
    {%- if form.errors -%}<div class="form-errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="ResetPassword">New password</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="ResetConfirm">Confirm password</label><input id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button class="button" type="submit">Reset password</button>
  {%- endform -%}
</section>

{% schema %}
{ "name": "Reset password" }
{% endschema %}
