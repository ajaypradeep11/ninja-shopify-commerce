<section class="container-wide section-pad">
  <div class="section-heading"><h1>{{ section.settings.heading }}</h1></div>
  <div class="collection-tiles">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <a class="collection-tile{% if collection.featured_image == blank %} collection-tile--text{% endif %}" href="{{ collection.url }}">
          {%- if collection.featured_image != blank -%}
            {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 700, 900', sizes: '(max-width: 639px) 50vw, 20vw', alt: collection.featured_image.alt }}
          {%- endif -%}
          <span class="collection-tile__title">{{ collection.title }}</span>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ]
}
{% endschema %}

