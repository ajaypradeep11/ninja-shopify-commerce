<section class="container-reading empty-state">
  <p class="eyebrow">404</p>
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.text }}</p>
  <a class="button" href="{{ routes.all_products_collection_url | append: '?sort_by=best-selling' }}">Shop all</a>
</section>

{% schema %}
{
  "name": "404 page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page vanished." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The ninja moved it—or the link is no longer available." }
  ]
}
{% endschema %}

