<section class="container-wide section-pad">
  {%- if section.settings.heading != blank -%}
    <div class="section-heading"><h2>{{ section.settings.heading }}</h2></div>
  {%- endif -%}
  <div class="collection-tiles">
    {%- for block in section.blocks -%}
      {%- assign tile_collection = block.settings.collection -%}
      {%- assign tile_image = block.settings.image | default: tile_collection.featured_image -%}
      <a class="collection-tile{% if tile_image == blank %} collection-tile--text{% endif %}" href="{{ tile_collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {%- if tile_image != blank -%}
          {{ tile_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 700, 900', sizes: '(max-width: 639px) 50vw, 20vw', alt: tile_image.alt }}
        {%- endif -%}
        <span class="collection-tile__title">{{ block.settings.title | default: tile_collection.title | default: 'Collection' }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection tiles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image" },
        { "type": "text", "id": "title", "label": "Custom title" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}

