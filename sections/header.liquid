{%- liquid
  assign best_selling_url = routes.all_products_collection_url | append: '?sort_by=best-selling'
  assign anime_sale_url = routes.root_url | append: 'collections/sale'
  assign anime_navigation = blank
  assign category_navigation = blank
  for navigation_link in section.settings.menu.links
    assign navigation_title = navigation_link.title | downcase
    if navigation_title contains 'anime'
      assign anime_navigation = navigation_link
    elsif navigation_title contains 'categor'
      assign category_navigation = navigation_link
    endif
  endfor
-%}

<header class="site-header" data-header>
    <div class="site-header__inset">
      <div class="site-header__pill">
        <div class="container-wide site-header__grid">
          <div class="site-header__left">
            <button
              class="icon-button"
              type="button"
              aria-label="Open menu"
              aria-expanded="false"
              data-menu-open
            >
              {% render 'icon', name: 'menu' %}
            </button>

            {%- comment -%}
              Mobile places the currency switch on the left, beside the menu button;
              the right-hand copy takes over from 640px. Only one is ever visible.
            {%- endcomment -%}
            {% render 'country-selector', placement: 'header-mobile' %}

            <details class="header-shop" data-header-shop>
              <summary class="header-utility-link">
                Shop
              </summary>
              <div class="header-shop__dropdown">
                <div class="header-shop__group">
                  {%- if anime_navigation != blank -%}
                    <a class="eyebrow" href="{{ anime_navigation.url }}">{{ anime_navigation.title }}</a>
                  {%- else -%}
                    <p class="eyebrow">By anime</p>
                  {%- endif -%}
                  <ul role="list">
                    {%- for link in anime_navigation.links -%}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                </div>
                <div class="header-shop__group">
                  {%- if category_navigation != blank -%}
                    <a class="eyebrow" href="{{ category_navigation.url }}">{{ category_navigation.title }}</a>
                  {%- else -%}
                    <p class="eyebrow">By category</p>
                  {%- endif -%}
                  <ul role="list">
                    {%- for link in category_navigation.links -%}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                </div>
                <a class="header-shop__all" href="{{ routes.all_products_collection_url }}">Shop all →</a>
              </div>
            </details>

            <a class="header-utility-link" href="{{ best_selling_url }}">
              Best-sellers
            </a>

            <a class="header-utility-link" href="{{ anime_sale_url }}">
              <span class="anime-sale-text">Sale</span>
            </a>
          </div>

          <a
            class="wordmark"
            href="{{ routes.root_url }}"
            aria-label="{{ shop.name }} home"
          >
            {%- if settings.logo != blank -%}
              {{
                settings.logo
                | image_url: width: 128
                | image_tag:
                  class: 'wordmark__logo',
                  widths: '80, 112, 128',
                  alt: ''
              }}
            {%- else -%}
              <img
                class="wordmark__logo"
                src="{{ 'logo-animated.svg' | asset_url }}"
                width="64"
                height="64"
                alt=""
              >
            {%- endif -%}

            <span class="wordmark__text">
              {{ settings.wordmark_base }}
              <span class="wordmark__accent">
                {{ settings.wordmark_accent }}
              </span>

              <span class="wordmark__star" aria-hidden="true">✦</span>
            </span>
          </a>

          <div class="site-header__right">
            {%- if section.settings.show_search -%}
              <form
                class="header-search"
                action="{{ routes.search_url }}"
                method="get"
                role="search"
              >
                <label
                  class="visually-hidden"
                  for="HeaderSearch-{{ section.id }}"
                >
                  Search
                </label>

                <input
                  id="HeaderSearch-{{ section.id }}"
                  type="search"
                  name="q"
                  value="{{ search.terms | escape }}"
                  placeholder="Search"
                  autocomplete="off"
                >

                <button type="submit" aria-label="Search">
                  {% render 'icon', name: 'search' %}
                </button>
              </form>
            {%- endif -%}

            {% render 'country-selector', placement: 'header' %}

            {%- if section.settings.show_account -%}
              <a
                class="icon-button"
                href="{{ routes.account_url }}"
                aria-label="Account"
              >
                {% render 'icon', name: 'user' %}
              </a>
            {%- endif -%}

            <a
              class="icon-button cart-link"
              href="{{ routes.cart_url }}"
              aria-label="Cart, {{ cart.item_count }} items"
            >
              {% render 'icon', name: 'bag' %}

              <span
                class="cart-count"
                data-cart-count
                {% if cart.item_count == 0 %}hidden{% endif %}
              >
                {{ cart.item_count }}
              </span>
            </a>
          </div>
        </div>
      </div>

      <!-- Drawer is intentionally outside the glass pill. -->
      <div class="menu-drawer" data-menu-drawer hidden>
        <button
          class="menu-drawer__scrim"
          type="button"
          aria-label="Close menu"
          data-menu-close
        ></button>

        <nav class="menu-drawer__panel" aria-label="Main navigation">
          <div class="menu-drawer__top">
            <span class="eyebrow">Menu</span>

            <button
              class="icon-button"
              type="button"
              aria-label="Close menu"
              data-menu-close
            >
              {% render 'icon', name: 'close' %}
            </button>
          </div>

          {%- if section.settings.show_search -%}
            <form
              class="drawer-search"
              action="{{ routes.search_url }}"
              method="get"
              role="search"
            >
              <label
                class="visually-hidden"
                for="DrawerSearch-{{ section.id }}"
              >
                Search
              </label>

              <input
                id="DrawerSearch-{{ section.id }}"
                type="search"
                name="q"
                placeholder="Search products"
              >

              <button type="submit" aria-label="Search">
                {% render 'icon', name: 'search' %}
              </button>
            </form>
          {%- endif -%}

          <ul class="menu-drawer__links" role="list">
            <li>
              <a href="{{ routes.all_products_collection_url }}">Shop</a>
            </li>

            <li>
              <a href="{{ anime_sale_url }}"><span class="anime-sale-text">Sale</span></a>
            </li>

            {%- for link in section.settings.menu.links -%}
              <li>
                <a href="{{ link.url }}">{{ link.title }}</a>

                {%- if link.links != blank -%}
                  <ul class="menu-drawer__subnav" role="list">
                    {%- for childlink in link.links -%}
                      <li>
                        <a href="{{ childlink.url }}">
                          {{ childlink.title }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>

          {% render 'country-selector', placement: 'drawer' %}
        </nav>
      </div>
    </div>
  </header>
{% stylesheet %}
    .site-header__pill {
      background: rgba(40, 38, 35, 0.72);
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow:
        0 12px 32px rgba(0, 0, 0, 0.35),
        inset 0 1px rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(18px) saturate(140%);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
    }

    .menu-drawer {
    z-index: 999;
    width: 100vw;
    height: 100dvh;
  }

  .menu-drawer__panel {
    height: 100dvh;
  }

    .header-search input {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.25);
    }

    .header-shop {
      position: relative;
      display: none;
    }

    .header-shop[open]::before {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      height: 10px;
      content: '';
    }

    .header-shop summary {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      list-style: none;
    }

    .header-shop summary::after {
      width: 6px;
      height: 6px;
      border-right: 1.5px solid currentColor;
      border-bottom: 1.5px solid currentColor;
      content: '';
      transform: translateY(-2px) rotate(45deg);
      transition: transform 160ms ease;
    }

    .header-shop[open] summary::after {
      transform: translateY(2px) rotate(225deg);
    }

    .header-shop summary::-webkit-details-marker {
      display: none;
    }

    .header-shop__dropdown {
      position: absolute;
      top: calc(100% + 10px);
      left: -8px;
      display: grid;
      overflow: hidden;
      width: min(500px, calc(100vw - 48px));
      grid-template-columns: 1fr 1fr;
      gap: 0;
      border: 1px solid rgba(40, 38, 35, 0.1);
      border-radius: 14px;
      background: #f7f5ef;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.32);
      color: #282623;
    }

    .header-shop__group {
      min-width: 0;
      padding: 20px;
    }

    .header-shop__group + .header-shop__group {
      border-left: 1px solid rgba(40, 38, 35, 0.1);
    }

    .header-shop__group .eyebrow {
      display: block;
      margin: 0 6px 10px;
      color: rgba(40, 38, 35, 0.55);
    }

    .header-shop__group ul {
      display: grid;
      gap: 2px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .header-shop__group li > a {
      display: block;
      padding: 7px 8px;
      border-radius: 8px;
      font-size: 14px;
      line-height: 1.25;
      transition: background-color 140ms ease, color 140ms ease;
    }

    .header-shop__group li > a:hover,
    .header-shop__group li > a:focus-visible,
    .header-shop__all:hover,
    .header-shop__all:focus-visible {
      background: rgba(255, 210, 42, 0.2);
      color: #191816;
    }

    .header-shop__group .eyebrow:hover,
    .header-shop__group .eyebrow:focus-visible {
      color: #282623;
    }

    .header-shop__all {
      grid-column: 1 / -1;
      padding: 14px 20px;
      border-top: 1px solid rgba(40, 38, 35, 0.1);
      background: #efede7;
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      transition: background-color 140ms ease, color 140ms ease;
    }

    @media (min-width: 1280px) {
      .site-header__left {
        gap: 4px;
      }

      .site-header__left > .header-utility-link,
      .header-shop > .header-utility-link {
        padding: 9px 10px;
        border-radius: 999px;
        line-height: 1;
        transition: background-color 140ms ease, color 140ms ease;
      }

      .site-header__left > .header-utility-link:hover,
      .site-header__left > .header-utility-link:focus-visible,
      .header-shop > .header-utility-link:hover,
      .header-shop > .header-utility-link:focus-visible,
      .header-shop[open] > .header-utility-link {
        background: rgba(255, 255, 255, 0.1);
      }

      .header-shop {
        display: block;
      }
    }
  {% endstylesheet %}
  {% style %}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
      z-index: 100;
      height: 0;
    }

    #shopify-section-{{ section.id }} .site-header {
      position: relative;
      top: auto;
    }
  {% endstyle %}
{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": true
    }
  ],
  "presets": [{ "name": "Header" }]
}
{% endschema %}
