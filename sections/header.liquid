{%- liquid
  assign best_selling_url = routes.all_products_collection_url | append: '?sort_by=best-selling'
  assign anime_sale_url = routes.root_url | append: 'collections/sale'
-%}

<header class="site-header" data-header>
    <div class="site-header__inset">
      <div class="site-header__pill">
        <div class="container-wide site-header__grid">
          <div class="site-header__left">
            <button
              class="icon-button"
              type="button"
              aria-label="Open menu"
              aria-expanded="false"
              data-menu-open
            >
              {% render 'icon', name: 'menu' %}
            </button>

            {%- comment -%}
              Mobile places the currency switch on the left, beside the menu button;
              the right-hand copy takes over from 640px. Only one is ever visible.
            {%- endcomment -%}
            {% render 'country-selector', placement: 'header-mobile' %}

            <details class="header-shop" data-header-shop>
              <summary class="header-utility-link">
                Shop <span class="header-shop__chevron" aria-hidden="true">⌄</span>
              </summary>
              <div class="header-shop__dropdown">
                <div class="header-shop__group">
                  <p class="eyebrow">By anime</p>
                  <ul role="list">
                    {% render 'header-shop-links', group: 'anime', menu: section.settings.anime_menu %}
                  </ul>
                </div>
                <div class="header-shop__group">
                  <p class="eyebrow">By category</p>
                  <ul role="list">
                    {% render 'header-shop-links', group: 'category', menu: section.settings.category_menu %}
                  </ul>
                </div>
                <a class="header-shop__all" href="{{ routes.all_products_collection_url }}">Shop all →</a>
              </div>
            </details>

            <a class="header-utility-link" href="{{ best_selling_url }}">
              Best-sellers
            </a>

            <a class="header-utility-link" href="{{ anime_sale_url }}">
              <span class="anime-sale-text">Sale</span>
            </a>
          </div>

          <a
            class="wordmark"
            href="{{ routes.root_url }}"
            aria-label="{{ shop.name }} home"
          >
            {%- if settings.logo != blank -%}
              {{
                settings.logo
                | image_url: width: 128
                | image_tag:
                  class: 'wordmark__logo',
                  widths: '80, 112, 128',
                  alt: ''
              }}
            {%- else -%}
              <img
                class="wordmark__logo"
                src="{{ 'logo-animated.svg' | asset_url }}"
                width="64"
                height="64"
                alt=""
              >
            {%- endif -%}

            <span class="wordmark__text">
              {{ settings.wordmark_base }}
              <span class="wordmark__accent">
                {{ settings.wordmark_accent }}
              </span>

              <span class="wordmark__star" aria-hidden="true">✦</span>
            </span>
          </a>

          <div class="site-header__right">
            {%- if section.settings.show_search -%}
              <form
                class="header-search"
                action="{{ routes.search_url }}"
                method="get"
                role="search"
              >
                <label
                  class="visually-hidden"
                  for="HeaderSearch-{{ section.id }}"
                >
                  Search
                </label>

                <input
                  id="HeaderSearch-{{ section.id }}"
                  type="search"
                  name="q"
                  value="{{ search.terms | escape }}"
                  placeholder="Search"
                  autocomplete="off"
                >

                <button type="submit" aria-label="Search">
                  {% render 'icon', name: 'search' %}
                </button>
              </form>
            {%- endif -%}

            {% render 'country-selector', placement: 'header' %}

            {%- if section.settings.show_account -%}
              <a
                class="icon-button"
                href="{{ routes.account_url }}"
                aria-label="Account"
              >
                {% render 'icon', name: 'user' %}
              </a>
            {%- endif -%}

            <a
              class="icon-button cart-link"
              href="{{ routes.cart_url }}"
              aria-label="Cart, {{ cart.item_count }} items"
            >
              {% render 'icon', name: 'bag' %}

              <span
                class="cart-count"
                data-cart-count
                {% if cart.item_count == 0 %}hidden{% endif %}
              >
                {{ cart.item_count }}
              </span>
            </a>
          </div>
        </div>
      </div>

      <!-- Drawer is intentionally outside the glass pill. -->
      <div class="menu-drawer" data-menu-drawer hidden>
        <button
          class="menu-drawer__scrim"
          type="button"
          aria-label="Close menu"
          data-menu-close
        ></button>

        <nav class="menu-drawer__panel" aria-label="Main navigation">
          <div class="menu-drawer__top">
            <span class="eyebrow">Menu</span>

            <button
              class="icon-button"
              type="button"
              aria-label="Close menu"
              data-menu-close
            >
              {% render 'icon', name: 'close' %}
            </button>
          </div>

          {%- if section.settings.show_search -%}
            <form
              class="drawer-search"
              action="{{ routes.search_url }}"
              method="get"
              role="search"
            >
              <label
                class="visually-hidden"
                for="DrawerSearch-{{ section.id }}"
              >
                Search
              </label>

              <input
                id="DrawerSearch-{{ section.id }}"
                type="search"
                name="q"
                placeholder="Search products"
              >

              <button type="submit" aria-label="Search">
                {% render 'icon', name: 'search' %}
              </button>
            </form>
          {%- endif -%}

          <ul class="menu-drawer__links" role="list">
            <li>
              <details class="menu-drawer__shop" open>
                <summary>Shop</summary>
                <div class="menu-drawer__shop-groups">
                  <div>
                    <p class="eyebrow">By anime</p>
                    <ul class="menu-drawer__subnav" role="list">
                      {% render 'header-shop-links', group: 'anime', menu: section.settings.anime_menu %}
                    </ul>
                  </div>
                  <div>
                    <p class="eyebrow">By category</p>
                    <ul class="menu-drawer__subnav" role="list">
                      {% render 'header-shop-links', group: 'category', menu: section.settings.category_menu %}
                    </ul>
                  </div>
                </div>
                <a class="menu-drawer__shop-all" href="{{ routes.all_products_collection_url }}">Shop all →</a>
              </details>
            </li>

            <li>
              <a href="{{ anime_sale_url }}"><span class="anime-sale-text">Sale</span></a>
            </li>

            {%- for link in section.settings.menu.links -%}
              <li>
                <a href="{{ link.url }}">{{ link.title }}</a>

                {%- if link.links != blank -%}
                  <ul class="menu-drawer__subnav" role="list">
                    {%- for childlink in link.links -%}
                      <li>
                        <a href="{{ childlink.url }}">
                          {{ childlink.title }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>

          {% render 'country-selector', placement: 'drawer' %}
        </nav>
      </div>
    </div>
  </header>
{% stylesheet %}
    .site-header__pill {
      background: rgba(40, 38, 35, 0.72);
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow:
        0 12px 32px rgba(0, 0, 0, 0.35),
        inset 0 1px rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(18px) saturate(140%);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
    }

    .menu-drawer {
    z-index: 999;
    width: 100vw;
    height: 100dvh;
  }

  .menu-drawer__panel {
    height: 100dvh;
  }

    .header-search input {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.25);
    }

    .header-shop {
      position: relative;
      display: none;
    }

    .header-shop summary {
      cursor: pointer;
      list-style: none;
    }

    .header-shop summary::-webkit-details-marker {
      display: none;
    }

    .header-shop__chevron {
      display: inline-block;
      margin-left: 2px;
      transition: transform 160ms ease;
    }

    .header-shop[open] .header-shop__chevron {
      transform: rotate(180deg);
    }

    .header-shop__dropdown {
      position: absolute;
      top: calc(100% + 18px);
      left: -18px;
      display: grid;
      width: min(560px, 80vw);
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      padding: 24px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 18px;
      background: #282623;
      box-shadow: 0 18px 48px rgba(0, 0, 0, 0.42);
    }

    .header-shop__dropdown::before {
      position: absolute;
      right: 0;
      bottom: 100%;
      left: 0;
      height: 18px;
      content: '';
    }

    .header-shop__group .eyebrow,
    .menu-drawer__shop .eyebrow {
      margin: 0 0 8px;
      color: rgba(244, 243, 239, 0.58);
    }

    .header-shop__group ul {
      display: grid;
      gap: 4px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .header-shop__group a {
      display: block;
      padding-block: 5px;
      font-size: 14px;
    }

    .header-shop__group a:hover,
    .header-shop__all:hover,
    .menu-drawer__shop a:hover {
      color: var(--brand);
    }

    .header-shop__all {
      grid-column: 1 / -1;
      padding-top: 14px;
      border-top: 1px solid rgba(244, 243, 239, 0.12);
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .menu-drawer__shop summary {
      padding-block: 11px;
      cursor: pointer;
      font-family: var(--font-display);
      font-size: 26px;
      font-weight: 700;
      letter-spacing: -0.03em;
      list-style-position: inside;
    }

    .menu-drawer__shop-groups {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      padding-top: 8px;
    }

    .menu-drawer__shop .menu-drawer__subnav {
      padding-left: 0;
    }

    .menu-drawer__shop-all {
      display: inline-block;
      margin-bottom: 14px;
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    @media (min-width: 1280px) {
      .header-shop {
        display: block;
      }
    }
  {% endstylesheet %}
  {% style %}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
      z-index: 100;
      height: 0;
    }

    #shopify-section-{{ section.id }} .site-header {
      position: relative;
      top: auto;
    }
  {% endstyle %}
{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "anime_menu",
      "label": "Shop by anime menu",
      "info": "Optional. Defaults to Naruto, One Piece, and Dragon Ball search links."
    },
    {
      "type": "link_list",
      "id": "category_menu",
      "label": "Shop by category menu",
      "info": "Optional. Defaults to the featured store categories."
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": true
    }
  ],
  "presets": [{ "name": "Header" }]
}
{% endschema %}
