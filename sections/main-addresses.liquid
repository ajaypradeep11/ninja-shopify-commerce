<script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer="defer"></script>
<section class="customer-page" style="width:min(100% - 32px, 960px)">
  <div class="section-heading">
    <h1>Addresses</h1>
    <a class="text-link" href="{{ routes.account_url }}">Back to account</a>
  </div>

  <details class="product-accordions" open>
    <summary>Add a new address</summary>
    <div class="product-accordions__content">
      {%- form 'customer_address', customer.new_address, class: 'form-grid' -%}
        <div class="form-grid form-grid--two">
          <div class="field"><label for="AddressFirstNameNew">First name</label><input id="AddressFirstNameNew" type="text" name="address[first_name]" autocomplete="given-name"></div>
          <div class="field"><label for="AddressLastNameNew">Last name</label><input id="AddressLastNameNew" type="text" name="address[last_name]" autocomplete="family-name"></div>
          <div class="field"><label for="AddressCompanyNew">Company</label><input id="AddressCompanyNew" type="text" name="address[company]" autocomplete="organization"></div>
          <div class="field"><label for="AddressPhoneNew">Phone</label><input id="AddressPhoneNew" type="tel" name="address[phone]" autocomplete="tel"></div>
        </div>
        <div class="field"><label for="Address1New">Address</label><input id="Address1New" type="text" name="address[address1]" autocomplete="address-line1" required></div>
        <div class="field"><label for="Address2New">Apartment, suite, etc.</label><input id="Address2New" type="text" name="address[address2]" autocomplete="address-line2"></div>
        <div class="form-grid form-grid--two">
          <div class="field"><label for="AddressCityNew">City</label><input id="AddressCityNew" type="text" name="address[city]" autocomplete="address-level2" required></div>
          <div class="field"><label for="AddressCountryNew">Country</label><select id="AddressCountryNew" name="address[country]" data-default="{{ form.country }}">{{ all_country_option_tags }}</select></div>
          <div class="field" id="AddressProvinceContainerNew"><label for="AddressProvinceNew">Province</label><select id="AddressProvinceNew" name="address[province]" data-default="{{ form.province }}"></select></div>
          <div class="field"><label for="AddressZipNew">Postal code</label><input id="AddressZipNew" type="text" name="address[zip]" autocomplete="postal-code" required></div>
        </div>
        <label class="filter-option"><input type="checkbox" name="address[default]" value="1"> Set as default address</label>
        <button class="button" type="submit">Add address</button>
      {%- endform -%}
    </div>
  </details>

  <div class="address-grid">
    {%- paginate customer.addresses by 12 -%}
      {%- for address in customer.addresses -%}
        <article class="address-card">
          {%- if address == customer.default_address -%}<p class="eyebrow">Default</p>{%- endif -%}
          <div class="rte">{{ address | format_address }}</div>
          {%- form 'customer_address', address -%}
            <input type="hidden" name="_method" value="delete">
            <button class="text-link" type="submit">Delete</button>
          {%- endform -%}
        </article>
      {%- endfor -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.Shopify && Shopify.CountryProvinceSelector) {
      new Shopify.CountryProvinceSelector('AddressCountryNew', 'AddressProvinceNew', { hideElement: 'AddressProvinceContainerNew' });
    }
  });
</script>

{% schema %}
{ "name": "Customer addresses" }
{% endschema %}
