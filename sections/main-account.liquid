<section class="customer-page" style="width:min(100% - 32px, 1100px)">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Welcome back</p>
      <h1>{{ customer.first_name | default: 'Account' }}</h1>
    </div>
    <a class="text-link" href="{{ routes.account_logout_url }}">Sign out</a>
  </div>

  <div class="customer-actions">
    <a class="button button--outline" href="{{ routes.account_addresses_url }}">Manage addresses</a>
  </div>

  <h2 style="margin-top:48px">Order history</h2>
  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size > 0 -%}
      <div style="overflow-x:auto">
        <table class="account-orders">
          <thead><tr><th>Order</th><th>Date</th><th>Payment</th><th>Fulfillment</th><th>Total</th></tr></thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr>
                <td><a class="text-link" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
                <td>{{ order.financial_status_label }}</td>
                <td>{{ order.fulfillment_status_label }}</td>
                <td>{{ order.total_net_amount | money_with_currency }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <p>You haven’t placed any orders yet.</p>
    {%- endif -%}
  {%- endpaginate -%}

  {%- if customer.default_address -%}
    <h2 style="margin-top:48px">Default address</h2>
    <div class="rte">{{ customer.default_address | format_address }}</div>
  {%- endif -%}
</section>

{% schema %}
{ "name": "Customer account" }
{% endschema %}

