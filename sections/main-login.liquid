<section class="customer-page">
  <h1>Sign in</h1>
  {%- form 'customer_login', novalidate: 'novalidate', class: 'form-grid' -%}
    {%- if form.errors -%}<div class="form-errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field">
      <label for="CustomerEmail">Email</label>
      <input id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required>
    </div>
    <div class="field">
      <label for="CustomerPassword">Password</label>
      <input id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required>
    </div>
    <button class="button" type="submit">Sign in</button>
  {%- endform -%}

  <div class="customer-actions">
    <a class="text-link" href="{{ routes.account_register_url }}">Create account</a>
  </div>

  <details class="product-accordions">
    <summary>Forgot your password?</summary>
    <div class="product-accordions__content">
      {%- form 'recover_customer_password', class: 'form-grid' -%}
        {%- if form.posted_successfully? -%}<div class="form-success">We sent you a password reset email.</div>{%- endif -%}
        {%- if form.errors -%}<div class="form-errors">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field">
          <label for="RecoverEmail">Email</label>
          <input id="RecoverEmail" type="email" name="email" autocomplete="email" required>
        </div>
        <button class="button button--outline" type="submit">Send reset link</button>
      {%- endform -%}
    </div>
  </details>
</section>

{% schema %}
{ "name": "Customer login" }
{% endschema %}

