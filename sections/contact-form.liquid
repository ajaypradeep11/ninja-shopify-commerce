<section class="container-reading page-section">
  <h1 class="page-title">{{ page.title | default: section.settings.heading }}</h1>
  {%- if page.content != blank -%}<div class="rte">{{ page.content }}</div>{%- endif -%}

  {%- form 'contact', class: 'contact-form' -%}
    {%- if form.posted_successfully? -%}<div class="form-success" tabindex="-1">Thanks for contacting us. We’ll get back to you shortly.</div>{%- endif -%}
    {%- if form.errors -%}<div class="form-errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="form-grid form-grid--two">
      <div class="field">
        <label for="ContactName-{{ section.id }}">Name</label>
        <input id="ContactName-{{ section.id }}" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name">
      </div>
      <div class="field">
        <label for="ContactEmail-{{ section.id }}">Email</label>
        <input id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="ContactPhone-{{ section.id }}">Phone</label>
        <input id="ContactPhone-{{ section.id }}" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
      </div>
    </div>
    <div class="field" style="margin-top:16px">
      <label for="ContactMessage-{{ section.id }}">Message</label>
      <textarea id="ContactMessage-{{ section.id }}" name="contact[body]" required>{{ form.body }}</textarea>
    </div>
    <button class="button" type="submit" style="margin-top:16px">Send message</button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" }
  ]
}
{% endschema %}

