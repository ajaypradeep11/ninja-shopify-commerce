<section class="hero-shell">
  <div class="hero" data-hero>
    <div class="hero__media">
      {%- liquid
        assign cta_json = ''
        assign first_cta_label = ''
        assign first_cta_link = ''
      -%}
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign cta_label = block.settings.cta_label
            if cta_label == blank
              if forloop.index == 1
                assign cta_label = 'Shop tshirts'
              else
                assign cta_label = section.settings.primary_label | default: 'Shop all'
              endif
            endif
            assign cta_link = block.settings.cta_link
            if cta_link == blank
              if forloop.index == 1
                if collections['t-shirts'] != blank
                  assign cta_link = collections['t-shirts'].url
                elsif collections['tshirts'] != blank
                  assign cta_link = collections['tshirts'].url
                endif
              else
                assign cta_link = section.settings.primary_link
              endif
            endif
            if cta_link == blank
              assign cta_link = routes.all_products_collection_url
            endif
            if forloop.first
              assign first_cta_label = cta_label
              assign first_cta_link = cta_link
            endif
            assign label_json = cta_label | json
            assign link_json = cta_link | json
            assign entry = '{"label":' | append: label_json | append: ',"href":' | append: link_json | append: '}'
            if forloop.first
              assign cta_json = entry
            else
              assign cta_json = cta_json | append: ',' | append: entry
            endif
          -%}
          {%- if block.settings.image != blank -%}
            {%- assign slide_class = 'hero__slide' -%}
            {%- if forloop.first -%}{%- assign slide_class = 'hero__slide is-active' -%}{%- endif -%}
            {{ block.settings.image | image_url: width: 3200 | image_tag:
              class: slide_class,
              loading: 'eager',
              widths: '750, 1200, 1800, 2400, 3200',
              sizes: '100vw',
              alt: block.settings.image.alt
            }}
          {%- elsif forloop.index == 1 -%}
            <img class="hero__slide is-active" src="{{ 'hero-opening-sale.jpg' | asset_url }}" width="3200" height="1344" alt="Opening sale" fetchpriority="high">
          {%- elsif forloop.index == 2 -%}
            <img class="hero__slide" src="{{ 'hero-opening-sale-2.jpg' | asset_url }}" width="3200" height="1344" alt="Opening sale — Solo Leveling and Demon Slayer merch">
          {%- elsif forloop.index == 3 -%}
            <img class="hero__slide" src="{{ 'hero.jpg' | asset_url }}" width="3200" height="1344" alt="Anime collectibles">
          {%- else -%}
            <div class="hero__slide hero__placeholder"></div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- liquid
          assign first_cta_label = 'Shop tshirts'
          assign first_cta_link = routes.all_products_collection_url
          if collections['t-shirts'] != blank
            assign first_cta_link = collections['t-shirts'].url
          elsif collections['tshirts'] != blank
            assign first_cta_link = collections['tshirts'].url
          endif
          assign second_label = section.settings.primary_label | default: 'Shop all'
          assign second_link = section.settings.primary_link | default: routes.all_products_collection_url
          assign first_link_json = first_cta_link | json
          assign second_label_json = second_label | json
          assign second_link_json = second_link | json
          assign first_label_json = first_cta_label | json
          assign cta_json = '{"label":' | append: first_label_json | append: ',"href":' | append: first_link_json | append: '},{"label":' | append: second_label_json | append: ',"href":' | append: second_link_json | append: '}'
        -%}
        <img class="hero__slide is-active" src="{{ 'hero-opening-sale.jpg' | asset_url }}" width="3200" height="1344" alt="Opening sale" fetchpriority="high">
        <img class="hero__slide" src="{{ 'hero-opening-sale-2.jpg' | asset_url }}" width="3200" height="1344" alt="Opening sale — Solo Leveling and Demon Slayer merch">
      {%- endif -%}
      <script type="application/json" data-hero-ctas>[{{ cta_json }}]</script>
      {%- if section.settings.label != blank -%}
        <p class="hero__media-label">{{ section.settings.label }}</p>
      {%- endif -%}
      <a class="hero__shop-all" href="{{ routes.all_products_collection_url }}">Shop All</a>
    </div>
    <div class="hero__scrim"></div>

    <div class="container-wide hero__content">
      <p class="hero__location">{{ section.settings.location_text }}</p>
      <div class="hero__copy">
        {%- if section.settings.label != blank -%}<p class="eyebrow">{{ section.settings.label }}</p>{%- endif -%}
        <h1>{{ section.settings.heading }}</h1>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        <div class="hero__actions">
          {%- if section.settings.primary_label != blank -%}
            <a class="button" data-hero-cta href="{{ first_cta_link | default: routes.all_products_collection_url }}">{{ first_cta_label | default: section.settings.primary_label }}</a>
          {%- endif -%}
          {%- if section.settings.secondary_label != blank -%}
            <a class="button button--white" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">{{ section.settings.secondary_label }}</a>
          {%- endif -%}
        </div>

        {%- liquid
          assign chip_tshirt_url = routes.all_products_collection_url
          if collections['t-shirts'] != blank
            assign chip_tshirt_url = collections['t-shirts'].url
          elsif collections['tshirts'] != blank
            assign chip_tshirt_url = collections['tshirts'].url
          endif
          assign chip_lamp_url = routes.all_products_collection_url
          if collections['anime-lamps'] != blank
            assign chip_lamp_url = collections['anime-lamps'].url
          elsif collections['lamps'] != blank
            assign chip_lamp_url = collections['lamps'].url
          endif
          assign chip_hoodie_url = routes.all_products_collection_url
          if collections['hoodies'] != blank
            assign chip_hoodie_url = collections['hoodies'].url
          elsif collections['hoodie'] != blank
            assign chip_hoodie_url = collections['hoodie'].url
          endif
        -%}
        <nav class="hero__chips" aria-label="Quick shop">
          <a class="hero__chip" href="{{ chip_tshirt_url }}">Tshirts</a>
          <a class="hero__chip" href="{{ chip_lamp_url }}">Lamps</a>
          <a class="hero__chip" href="{{ chip_hoodie_url }}">Hoodie</a>
        </nav>
      </div>
    </div>

    {%- assign slide_count = section.blocks.size -%}
    {%- if slide_count == 0 -%}{%- assign slide_count = 2 -%}{%- endif -%}
    {%- if slide_count > 1 -%}
      <div class="hero__dots" aria-label="Choose hero slide">
        {%- for index in (1..slide_count) -%}
          <button class="hero__dot{% if index == 1 %} is-active{% endif %}" type="button" aria-label="Show slide {{ index }}" aria-current="{% if index == 1 %}true{% else %}false{% endif %}" data-hero-dot></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "LocalNinja hero",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "location_text",
      "label": "Location text",
      "default": "📍 OTTAWA · FREE SHIPPING"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "COLLECTIBLE LED LAMPS"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Your favorite anime, in a whole new light."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Collectible LED lamps featuring the characters and worlds you love."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop anime lamps"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "info": "Shown on the main hero button while this slide is active. Defaults: slide 1 \"Shop tshirts\", later slides use the section's primary button label."
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LocalNinja hero",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
