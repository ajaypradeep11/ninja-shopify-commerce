{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background_color | default: '#ffffff' }};
  }
{% endstyle %}

<div class="selvedge" aria-hidden="true" style="margin-block: {{ section.settings.margin }}px"></div>

{% schema %}
{
  "name": "Ninja divider",
  "class": "section-divider",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "margin",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Vertical spacing",
      "default": 24
    }
  ],
  "presets": [{ "name": "Ninja divider" }]
}
{% endschema %}

