{%- liquid
  assign related_collection = product.collections.first
  assign shown = 0
-%}
{%- if related_collection != blank -%}
  <section class="container-wide section-pad">
    <div class="section-heading"><h2>{{ section.settings.heading }}</h2></div>
    <div class="product-grid">
      {%- for related_product in related_collection.products -%}
        {%- if related_product.id != product.id and shown < section.settings.products_to_show -%}
          {% render 'product-card', product: related_product %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 6, "step": 1, "label": "Products to show", "default": 4 }
  ]
}
{% endschema %}

