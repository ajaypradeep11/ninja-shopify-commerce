<section class="container-wide section-pad anime-chips-section">
  {%- if section.settings.heading != blank -%}
    <div class="section-heading"><h2>{{ section.settings.heading }}</h2></div>
  {%- endif -%}
  <div class="anime-chips">
    {%- for block in section.blocks -%}
      {%- liquid
        assign chip_url = block.settings.link
        if chip_url == blank and block.settings.name != blank
          assign guess = block.settings.name | handleize
          if collections[guess] != blank
            assign chip_url = collections[guess].url
          endif
        endif
      -%}
      {%- if chip_url == blank -%}
        {%- capture chip_url -%}{{ routes.search_url }}?q={{ block.settings.name | url_encode }}{%- endcapture -%}
      {%- endif -%}
      <a class="anime-chip" href="{{ chip_url }}" {{ block.shopify_attributes }}>{{ block.settings.name }}</a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Anime chips",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by anime"
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Chip",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Naruto" },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Leave blank to auto-link a matching collection, or fall back to search."
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Anime chips",
      "blocks": [{ "type": "chip" }, { "type": "chip" }, { "type": "chip" }]
    }
  ]
}
{% endschema %}
