<section class="container-wide section-pad anime-chips-section" data-scroll-nav>
  {%- if section.settings.heading != blank -%}
    <div class="section-heading">
      <h2>{{ section.settings.heading }}</h2>
      <div class="anime-nav">
        {%- if section.settings.link_label != blank -%}
          <a class="tiles-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
        {%- endif -%}
        <button class="anime-nav__btn anime-nav__btn--prev" type="button" aria-label="Scroll left" data-rail-prev>{% render 'icon', name: 'chevron' %}</button>
        <button class="anime-nav__btn" type="button" aria-label="Scroll right" data-rail-next>{% render 'icon', name: 'chevron' %}</button>
      </div>
    </div>
  {%- endif -%}
  <div class="anime-chips" data-scroll-rail>
    {%- for block in section.blocks -%}
      {%- liquid
        assign chip_url = block.settings.link
        assign chip_image = block.settings.image
        if block.settings.name != blank
          assign guess = block.settings.name | handleize
          if collections[guess] != blank
            if chip_url == blank
              assign chip_url = collections[guess].url
            endif
            if chip_image == blank
              assign chip_image = collections[guess].featured_image
            endif
          endif
        endif
      -%}
      {%- if chip_url == blank -%}
        {%- capture chip_url -%}{{ routes.search_url }}?q={{ block.settings.name | url_encode }}{%- endcapture -%}
      {%- endif -%}
      <a class="anime-chip{% if chip_image != blank %} anime-chip--image{% endif %}" href="{{ chip_url }}" {{ block.shopify_attributes }}>
        {%- if chip_image != blank -%}
          <span class="anime-chip__avatar">
            {{ chip_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '80px', alt: block.settings.name }}
          </span>
        {%- endif -%}
        <span>{{ block.settings.name }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Anime chips",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by anime"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all →"
    },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Chip",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Naruto" },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Round image",
          "info": "Leave blank to use the matching collection's image."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Leave blank to auto-link a matching collection, or fall back to search."
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Anime chips",
      "blocks": [{ "type": "chip" }, { "type": "chip" }, { "type": "chip" }]
    }
  ]
}
{% endschema %}
